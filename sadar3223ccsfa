						ok, err = ConfigSystem:Load(name)
					end
					if ok then
						Sena:Notify({ Title = "Config loaded", Content = name, Icon = "folder-open" })
					else
						Sena:Notify({ Title = "Load failed", Content = tostring(err or "Config not found."), Icon = "triangle-alert" })
					end
				end)

				local RowTwo = ActionRow()

				Action(RowTwo, 1, "trash-2", "Delete", function()
					local name = CurrentName()
					if name == "" then return end

					local ok
					if itemCfg.OnDelete then
						ok = itemCfg.OnDelete(name)
					else
						ok = ConfigSystem:Delete(name)
					end
					if ok then
						if NameInput then NameInput:Set("", true) end
						RefreshList("")
						if ConfigList then ConfigList:Clear() end
						Sena:Notify({ Title = "Config deleted", Content = name, Icon = "trash-2" })
					else
						Sena:Notify({ Title = "Delete failed", Content = name, Icon = "triangle-alert" })
					end
				end)

				Action(RowTwo, 2, "rotate-cw", "Refresh", function()
					RefreshList(CurrentName())
					Sena:Notify({ Title = "Config", Content = "Config list refreshed.", Icon = "rotate-cw", Duration = 2 })
				end)

				local PasteInput
				local RowThree = ActionRow()

				Action(RowThree, 1, "clipboard-copy", "Export", function()
					local encoded = ConfigSystem:Export()
					if not encoded then
						Sena:Notify({ Title = "Export failed", Content = "Could not encode the config.", Icon = "triangle-alert" })
						return
					end

					if CopyToClipboard(encoded) then
						Sena:Notify({
							Title = "Config exported",
							Content = "Config JSON copied to clipboard.",
							Icon = "clipboard-check",
						})
						return
					end

					if ConfigSystem.HasFiles then
						local path = ConfigSystem.Folder .. "/export.json"
						if pcall(function() writefile(path, encoded) end) then
							Sena:Notify({
								Title = "Config exported",
								Content = "No clipboard support, saved to " .. path,
								Icon = "save",
								Duration = 7,
							})
							return
						end
					end

					Sena:Notify({
						Title = "Export failed",
						Content = "This executor supports neither clipboard nor writefile.",
						Icon = "triangle-alert",
						Duration = 7,
					})
				end)

				Action(RowThree, 2, "clipboard-paste", "Import", function()
					local raw = ReadClipboard()

					if not raw and PasteInput then
						local typed = tostring(PasteInput:Get() or "")
						if typed ~= "" then raw = typed end
					end

					if not raw and ConfigSystem.HasFiles then
						pcall(function()
							local path = ConfigSystem.Folder .. "/export.json"
							if isfile(path) then raw = readfile(path) end
						end)
					end

					if not raw then
						Sena:Notify({
							Title = "Import failed",
							Content = "Nothing to import. Paste the config JSON into the Import Data field.",
							Icon = "triangle-alert",
							Duration = 7,
						})
						return
					end

					if ConfigSystem:Import(raw) then
						Sena:Notify({ Title = "Config imported", Content = "All values have been applied.", Icon = "clipboard-check" })
						if PasteInput then PasteInput:Set("", true) end
					else
						Sena:Notify({ Title = "Import failed", Content = "That is not valid config JSON.", Icon = "triangle-alert" })
					end
				end)

				if not CanReadClipboard() then
					PasteInput = Elements:AddInput({
						Title       = "Import Data",
						Description = "This executor cannot read the clipboard. Paste the config JSON here.",
						Placeholder = "{\"...\":...}",
						Width       = 110,
						NoConfig    = true,
						Callback    = function() end,
					})
				end

				AutoLoadToggle = Elements:AddToggle({
					Title       = "Auto Load",
					Description = "Load this config automatically on every run.",
					Default     = ConfigSystem:GetAutoLoad() ~= "",
					NoConfig    = true,
					Callback    = function(state)
						if suppressAutoLoad then return end
						local name = CurrentName()
						if state and name == "" then
							Sena:Notify({ Title = "Auto Load", Content = "Select a config first.", Icon = "triangle-alert" })
							return
						end
						ConfigSystem:SetAutoLoad(name, state)
					end,
				})

				if not ConfigSystem.HasFiles then
					Elements:AddLabel({
						Title = "No file API on this executor, configs last for this session only.",
					})
				end

				if itemCfg.AutoLoad ~= false and not ConfigSystem.AutoLoaded then
					ConfigSystem.AutoLoaded = true
					local pick = ConfigSystem:GetAutoLoad()
					if pick ~= "" then
						task.defer(function()
							task.wait(0.35)
							if ConfigSystem:Load(pick) then
								if NameInput then NameInput:Set(pick, true) end
								RefreshList(pick)
								Sena:Notify({ Title = "Auto loaded", Content = pick, Icon = "folder-open" })
							end
						end)
					end
				end

				local panel = {}
				function panel:GetName() return CurrentName() end
				function panel:SetName(name)
					if NameInput then NameInput:Set(tostring(name or ""), true) end
				end
				function panel:Refresh(selectName) RefreshList(selectName) end
				function panel:GetList() return ConfigSystem:GetConfigs() end
				function panel:Save(name) return ConfigSystem:Save(name or CurrentName()) end
				function panel:Load(name) return ConfigSystem:Load(name or CurrentName()) end
				function panel:Delete(name) return ConfigSystem:Delete(name or CurrentName()) end

				return panel
			end

			Elements.AddConfig = Elements.AddConfigPanel

			Section.Api = Elements
			return Elements
		end

		TabApi.CreateSection = TabApi.AddSection
		TabApi.Title = tabTitle
		TabApi.Key = key

		function TabApi:Select() SelectTab(key) end

		if not Window.CurrentTab then
			SelectTab(key)
		end

		return TabApi
	end

	Window.AddTab = Window.CreateTab

	Sena.Windows[#Sena.Windows + 1] = Window
	SetOpen(true)

	return Window
end

return Sena
