			Elements.AddConfig = Elements.AddConfigPanel
			Elements.AddPanelConfig = Elements.AddConfigPanel
			-- Partner matchmaking buat shrine fusion (Steal an Egg). Dua elemen:
			--   AddFusePartner  -> kontrol (tier / pet / auto / status / broadcast)
			--   AddFuseList     -> daftar broadcast orang lain + tombol Join,
			--                      bisa ditaruh di section lain (kolom kanan)
			-- Semua status datang dari /sync (param fuse=1) yang memang sudah
			-- dipoll; tidak ada loop sendiri, daftar cuma dibangun ulang kalau
			-- isinya berubah. Hub kasih callback:
			--   Pets(tier)      -> { {Uid=, Category=, Side="Light"|"Dark", Label=} }
			--   Teleport(job, place) -> true kalau teleport dimulai (session mati)
			--   OnMatched(m) / OnCancelled(m)
			function Elements:AddFusePartner(itemCfg)
				itemCfg = itemCfg or {}
				local T = itemCfg.Text or {}
				local function L(key, fallback) local v = T[key] return (v ~= nil and tostring(v)) or fallback end
				local tiers     = itemCfg.Tiers or { "Divine", "Eternal" }
				local getPets   = itemCfg.Pets or function() return {} end
				local teleport  = itemCfg.Teleport or function() return false, "no teleport" end
				local onMatched = itemCfg.OnMatched or function() end
				local onCancel  = itemCfg.OnCancelled or function() end

				local st = {
					tier = tiers[1],
					auto = itemCfg.AutoSelect ~= false,
					pets = {},        -- label -> pet
					petLabel = "",
					mine = nil,       -- payload.mine terakhir
					matchedId = nil,  -- OnMatched sudah dipanggil buat id ini
					teleporting = false,
					busy = false,
				}

				-- ---- kontrol (pakai elemen standar biar gayanya sama) -------------
				local TierDrop = Elements:AddDropdown({
					Title = L("Tier", "Tier"),
					Content = L("TierDesc", "Divine = ArchAngel + World Burner. Eternal = Pegasus + Skeleton Horse."),
					Options = tiers,
					Default = tiers[1],
					NoConfig = true,
					Callback = function(v)
						st.tier = (type(v) == "table") and (v[1] or tiers[1]) or tostring(v or tiers[1])
						if st.RefreshPets then st.RefreshPets() end
					end,
				})

				local PetDrop = Elements:AddDropdown({
					Title = L("Pet", "Your Pet"),
					Content = L("PetDesc", "Recipe pets you own for this tier. The pet decides your pad side."),
					Options = {},
					Default = "",
					NoConfig = true,
					Callback = function(v)
						st.petLabel = (type(v) == "table") and (v[1] or "") or tostring(v or "")
					end,
				})

				Elements:AddToggle({
					Title = L("Auto", "Auto Select"),
					Content = L("AutoDesc", "Use the first recipe pet found in your inventory."),
					Default = st.auto,
					NoConfig = true,
					Callback = function(v) st.auto = v and true or false end,
				})

				local Status = Elements:AddParagraph({
					Title = L("Status", "Status"),
					Content = L("Idle", "Not broadcasting."),
				})
				local function SetStatus(text)
					pcall(function() Status:Set({ Content = tostring(text or "") }) end)
				end

				local Broadcast
				local function SetBroadcastLabel(active)
					pcall(function()
						Broadcast:Set({ Title = active and L("Stop", "Stop Broadcast") or L("Broadcast", "Broadcast: Find Partner") })
					end)
				end

				-- ---- helper -------------------------------------------------------
				local function Call(path, params)
					return Sena:BackendCall(path, params)
				end

				function st.RefreshPets()
					local ok, list = pcall(getPets, st.tier)
					if not ok or type(list) ~= "table" then list = {} end
					st.pets = {}
					local labels = {}
					for _, pet in ipairs(list) do
						local label = tostring(pet.Label or (tostring(pet.Category) .. " (" .. tostring(pet.Side) .. ")"))
						if not st.pets[label] then
							st.pets[label] = pet
							labels[#labels + 1] = label
						end
					end
					pcall(function() PetDrop:Refresh(labels, true) end)
					if #labels == 0 then
						st.petLabel = ""
					elseif st.petLabel == "" or not st.pets[st.petLabel] then
						st.petLabel = labels[1]
						pcall(function() PetDrop:Set(labels[1], true) end)
					end
					return labels
				end

				local function PickPet(needCategory, targetTier)
					st.RefreshPets()
					if needCategory then
						for _, pet in pairs(st.pets) do
							if tostring(pet.Category) == tostring(needCategory) then return pet end
						end
						if targetTier and targetTier ~= st.tier then
							local okT, listT = pcall(getPets, targetTier)
							if okT and type(listT) == "table" then
								for _, pet in ipairs(listT) do
									if tostring(pet.Category) == tostring(needCategory) then return pet end
								end
							end
						end
						local okA, listA = pcall(getPets, nil)
						if okA and type(listA) == "table" then
							for _, pet in ipairs(listA) do
								if tostring(pet.Category) == tostring(needCategory) then return pet end
							end
						end
						return nil
					end
					if st.auto then
						for _, label in ipairs(PetDrop:GetOptions()) do
							if st.pets[label] then return st.pets[label] end
						end
						return nil
					end
					return st.pets[st.petLabel]
				end

				local function Terminal(mine)
					if st.matchedId == mine.id or mine.state == "cancelled" or mine.state == "declined" then
						local ok, err = pcall(onCancel, mine)
						if not ok then warn("[Sena] fuse OnCancelled error:", err) end
					end
					st.matchedId = nil
					st.teleporting = false
					st._promptKey = nil
					Call("/fuse/leave", {})
					SetBroadcastLabel(false)
					if mine.state == "done" then
						SetStatus(L("Done", "Fusion complete."))
					elseif mine.state == "declined" then
						local why = tostring(mine.reason or L("Declined", "Partner declined the request."))
						SetStatus(why)
						pcall(function()
							if Sena and Sena.Notify then
								Sena:Notify({ Title = L("ListTitle", "Partner Fuse"), Content = why, Duration = 5 })
							end
						end)
					else
						local why = tostring(mine.reason or "")
						SetStatus(L("Cancelled", "Cancelled") .. (why ~= "" and (" (" .. why .. ")") or ""))
					end
				end

				local function Matched(mine)
					if st.matchedId == mine.id then return end
					st.matchedId = mine.id
					st.teleporting = false
					st._promptKey = nil
					SetStatus(L("Matched", "Matched with ") .. tostring(mine.partner or "?") .. " - " .. L("Heading", "heading to the shrine."))
					local m = {
						id = mine.id, role = mine.role, tier = mine.tier, side = mine.side,
						need = mine.need, partner_uid = tonumber(mine.partner_uid), partner = mine.partner,
						partner_cat = mine.partner_cat, place = mine.place, job = mine.job,
					}
					task.spawn(function()
						Elevate()
						local ok, err = pcall(onMatched, m)
						if not ok then warn("[Sena] fuse OnMatched error:", err) end
					end)
				end

				local StopBroadcast

				-- ---- join (dipanggil dari AddFuseList lewat FuseCore) ---------------
				local function Join(entry, onFeedback)
					local now = os.clock()
					if st.busy and (now - (st._busyAt or 0) < 4) then
						if onFeedback then onFeedback("busy") end
						return
					end
					st.busy = true
					st._busyAt = now
					task.spawn(function()
						Elevate()
						local ok, err = pcall(function()
							local pet = PickPet(entry.need, entry.tier)
							if not pet then
								local needText = tostring(entry.need or "?")
								SetStatus(L("NeedPet", "You need ") .. needText .. L("NeedPetTail", " (recipe pet) to join."))
								pcall(function()
									if Sena and Sena.Notify then
										Sena:Notify({
											Title = L("ListTitle", "Partner Fuse"),
											Content = L("NeedPet", "You need ") .. needText .. L("NeedPetTail", " (recipe pet) to join."),
											Duration = 4,
										})
									end
								end)
								if onFeedback then onFeedback("need_pet", needText) end
								st.busy = false
								return
							end
							if onFeedback then onFeedback("claiming") end
							SetStatus(L("Claiming", "Requesting to join ") .. tostring(entry.name or "partner") .. "...")
							local data, callErr = Call("/fuse/claim", { id = entry.id, cat = pet.Category, pet = pet.Uid })
							if not data or callErr then
								local msg = tostring(callErr or "error")
								if msg == "taken" then msg = L("Taken", "Someone else just took it.") end
								if msg:match("^blocked:") then msg = L("Blocked", "You are blocked from partner matching for a while.") end
								if msg == "stop_your_post_first" then msg = L("StopFirst", "Stop your own broadcast first.") end
								SetStatus(msg)
								pcall(function()
									if Sena and Sena.Notify then
										Sena:Notify({ Title = L("ListTitle", "Partner Fuse"), Content = msg, Duration = 3 })
									end
								end)
								if onFeedback then onFeedback("error", msg) end
								st.busy = false
								return
							end
							-- 2-way handshake: tunggu poster accept lewat prompt
							SetStatus(L("WaitingApproval", "Request sent! Waiting for ") .. tostring(data.partner or entry.name or "partner") .. L("WaitingApprovalTail", " to accept..."))
							pcall(function()
								if Sena and Sena.Notify then
									Sena:Notify({
										Title = L("ListTitle", "Partner Fuse"),
										Content = "Request sent to " .. tostring(data.partner or entry.name or "partner") .. "! Waiting for approval...",
										Duration = 4,
									})
								end
							end)
							st.busy = false
						end)
						if not ok then
							st.busy = false
							warn("[SenaLib] Join error:", err)
						end
					end)
				end
				FuseCore.join = Join
				FuseCore.text = L
				FuseCore.stop = function() StopBroadcast() end

				-- ---- broadcast ------------------------------------------------------
				local function StartBroadcast()
					local pet = PickPet(nil)
					if not pet then
						SetStatus(L("NoPet", "No recipe pet for this tier in your inventory."))
						pcall(function()
							if Sena and Sena.Notify then
								Sena:Notify({
									Title = L("ListTitle", "Partner Fuse"),
									Content = "No recipe pet found for " .. tostring(st.tier or "") .. " in your inventory!",
									Duration = 4,
								})
							end
						end)
						return
					end
					SetStatus(L("Posting", "Broadcasting..."))
					local data, err = Call("/fuse/post", { cat = pet.Category, pet = pet.Uid, job = game.JobId, place = game.PlaceId })
					if not data or err then
						local msg = tostring(err or "error")
						if msg:match("^cooldown:") then msg = L("Cooldown", "Wait ") .. msg:match("%d+") .. "s" end
						if msg:match("^blocked:") then msg = L("Blocked", "You are blocked from partner matching for a while.") end
						if msg == "already_joining" then msg = L("AlreadyJoining", "You are already joining someone.") end
						SetStatus(msg)
						return
					end
					SetBroadcastLabel(true)
					SetStatus(L("Waiting", "Waiting for a ") .. tostring(data.side == "Light" and "Dark" or "Light")
						.. " " .. L("Partner", "partner") .. " (" .. tostring(data.need) .. ")...")
				end

				function StopBroadcast()
					st._promptKey = nil
					Call("/fuse/stop", {})
					SetBroadcastLabel(false)
					SetStatus(L("Idle", "Not broadcasting."))
				end

				Broadcast = Elements:AddButton({
					Title = L("Broadcast", "Broadcast: Find Partner"),
					Content = L("BroadcastDesc", "Tell other players you are waiting at the shrine. Only works if you really own the pet."),
					Locked = (itemCfg.Locked == true or itemCfg.BroadcastLocked == true),
					Callback = function()
						if st.busy then return end
						st.busy = true
						local mine = st.mine
						if mine and mine.role == "poster" and (mine.state == "open" or mine.state == "claimed" or mine.state == "accepted") then
							StopBroadcast()
						else
							StartBroadcast()
						end
						st.busy = false
					end,
				})

				-- ---- sync -------------------------------------------------------------
				local function OnSync(payload)
					if type(payload) ~= "table" or not Status then return end
					local list = type(payload.list) == "table" and payload.list or {}
					for i = #FuseCore.lists, 1, -1 do
						local l = FuseCore.lists[i]
						if not l.Alive() then table.remove(FuseCore.lists, i) else pcall(l.Update, list) end
					end

					local mine = payload.mine
					st.mine = (type(mine) == "table") and mine or nil
					if type(mine) ~= "table" then
						if st.matchedId then st.matchedId = nil end
						st._promptKey = nil
						return
					end
					if mine.state == "cancelled" or mine.state == "done" or mine.state == "declined" then
						Terminal(mine)
					elseif mine.role == "poster" then
						SetBroadcastLabel(true)
						if mine.state == "open" then
							st._promptKey = nil
							SetStatus(L("Waiting", "Waiting for a ") .. tostring(mine.side == "Light" and "Dark" or "Light")
								.. " " .. L("Partner", "partner") .. " (" .. tostring(mine.need) .. ")...")
						elseif mine.state == "claimed" then
							-- 2-WAY HANDSHAKE: Broadcaster prompt Accept / Decline
							local promptKey = tostring(mine.id) .. "_" .. tostring(mine.partner_uid)
							if st._promptKey ~= promptKey then
								st._promptKey = promptKey
								SetStatus(L("IncomingRequest", "Partner request from ") .. tostring(mine.partner or "?") .. " (" .. tostring(mine.partner_cat or "pet") .. ")! Waiting for your response...")
								pcall(function()
									if Sena and Sena.Prompt then
										Sena:Prompt({
											Title = tostring(mine.partner or "Partner Request"),
											Content = "Wants to fuse for " .. tostring(mine.tier or "") .. " with " .. tostring(mine.partner_cat or "their pet") .. "!\nAccept and invite to your server?",
											Avatar = tostring(mine.partner_uid or ""):match("^%d+$") and mine.partner_uid or nil,
											Accept = L("Accept", "Accept"),
											Decline = L("Decline", "Decline"),
											Duration = 35,
											Callback = function(accepted)
												if accepted == true then
													SetStatus(L("AcceptedPartner", "Accepted ") .. tostring(mine.partner or "partner") .. L("AcceptedPartnerTail", "! Waiting for them to arrive..."))
													Call("/fuse/accept", { id = mine.id, job = game.JobId, place = game.PlaceId })
												else
													SetStatus(L("DeclinedPartner", "Declined request from ") .. tostring(mine.partner or "partner") .. ".")
													Call("/fuse/decline", { id = mine.id })
													st._promptKey = nil
												end
											end,
										})
									end
								end)
							end
						elseif mine.state == "accepted" then
							SetStatus(L("OnTheWay", "Partner ") .. tostring(mine.partner or "?") .. L("OnTheWayTail", " accepted! Waiting for them to arrive..."))
						elseif mine.state == "matched" then
							Matched(mine)
						end
					elseif mine.role == "joiner" then
						if mine.state == "claimed" then
							SetStatus(L("WaitingApproval", "Request sent! Waiting for ") .. tostring(mine.partner or "partner") .. L("WaitingApprovalTail", " to accept..."))
						elseif mine.state == "accepted" then
							-- Broadcaster accepted! Joiner can now teleport or enter shrine
							if tostring(mine.job) == tostring(game.JobId) then
								SetStatus(L("InSameServer", "Accepted! In the same server. Heading to shrine..."))
								Call("/fuse/arrived", { id = mine.id })
							elseif not st.teleporting then
								SetStatus(L("Teleporting", "Accepted! Joining ") .. tostring(mine.partner or "?") .. L("TeleportingTail", "'s server..."))
								st.teleporting = true
								pcall(function()
									if Sena and Sena.Notify then
										Sena:Notify({
											Title = L("ListTitle", "Partner Fuse"),
											Content = tostring(mine.partner or "Partner") .. " accepted! Teleporting...",
											Duration = 4,
										})
									end
								end)
								local okT, res, terr = pcall(teleport, mine.job, mine.place)
								if not okT or not res then
									st.teleporting = false
									Call("/fuse/fail", { id = mine.id, reason = "teleport" })
									SetStatus(L("TeleportFailed", "Teleport failed: ") .. tostring(terr or res or "unknown"))
								end
							end
						elseif mine.state == "matched" then
							Matched(mine)
						end
					end
				end

				if Sena:GetBackend() then
					Sena:SetSyncExtra("fuse", 1)
					Sena:OnFuse(OnSync)
				else
					SetStatus(L("NoBackend", "Backend link is off; partner matching unavailable."))
				end
				task.defer(function() Elevate() pcall(st.RefreshPets) end)

				-- ---- API buat hub -----------------------------------------------------
				local funcs = {}
				function funcs:SetStatus(text) SetStatus(text) end
				function funcs:Refresh() return st.RefreshPets() end
				function funcs:Current() return st.mine end
				function funcs:Report(reason)
					local mine = st.mine
					if not mine then return false end
					local data, err = Call("/fuse/report", { id = mine.id, reason = tostring(reason or "no_pet") })
					return data ~= nil and err == nil
				end
				function funcs:Done()
					local mine = st.mine
					if not mine then return false end
					local data, err = Call("/fuse/done", { id = mine.id })
					return data ~= nil and err == nil
				end
				function funcs:Leave()
					st.matchedId = nil
					local data, err = Call("/fuse/leave", {})
					SetBroadcastLabel(false)
					return data ~= nil and err == nil
				end
				function funcs:Stop() StopBroadcast() end
				return funcs
			end

