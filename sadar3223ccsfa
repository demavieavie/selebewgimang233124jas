-- Private message to a Roblox username who is online in Sena. Same cooldown
-- and word filter as global chat; the server echoes it back with mine=true.
function Sena:SendDM(toName, text)
	if not Backend then return false, "not connected" end
	toName = tostring(toName or ""):gsub("^@", "")
	text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if toName == "" then return false, "who?" end
	if text == "" then return false, "empty" end
	local data, err = Sena:BackendCall("/dm/send", { to = toName, text = text })
	if not data then return false, err end
	if data.ok then return true, data.to_name end
	err = tostring(data.error or "error")
	if err:match("^badword") then
		local minutes = err:match("^badword:(%d+)") or "?"
		local reason = "Sena: kata kasar terdeteksi di chat. Ban " .. minutes .. " menit."
		task.delay(1.5, function() pcall(function() LocalPlayer:Kick(reason) end) end)
	end
	return false, err
end

function Sena:RequestJoin(toName)
	if not Backend then return false, "not connected" end
	toName = tostring(toName or ""):gsub("^@", "")
	if toName == "" then return false, "who?" end
	local data, err = Sena:BackendCall("/join/request", { to = toName })
	if not data then return false, err end
	if data.ok then return true, data.to_name end
	return false, tostring(data.error or "error")
end

function Sena:AnswerJoin(id, accept)
	if not Backend then return false, "not connected" end
	local data, err = Sena:BackendCall("/join/answer", {
		id = tostring(id),
		accept = accept and "1" or "0",
		place = tostring(game.PlaceId),
		job = tostring(game.JobId),
	})
	if not data then return false, err end
	if data.ok then return true end
	return false, tostring(data.error or "error")
end

function Sena:CreateWindow(config)
	config = config or {}

	-- Window baru berarti lib ini dipakai lagi. Kalau tabel lib-nya dishare
	-- antar re-execute, Window:Destroy sebelumnya udah matiin loop backend;
	-- nyalain lagi di sini.
	Sena.Unloaded = false
	if not Backend then
		local ok, cfg = pcall(function() return getgenv and getgenv().SenaBackend end)
		local defaultGame = config.SubTitle or config.Title or ""
		local bCfg = (ok and type(cfg) == "table") and cfg or {}
		if not bCfg.Game or bCfg.Game == "" then bCfg.Game = defaultGame end
		Sena:ConnectBackend(bCfg)
	elseif not Backend.LoopAlive then
		Sena:ConnectBackend()
	end

	-- Auto verify getgenv().SenaKey directly in UI Lib
	pcall(function()
		Sena:CheckDonatorKey()
	end)

	local title      = tostring(config.Title or config[1] or "Sena")
	local subTitle   = tostring(config.SubTitle or config.Description or config[2] or "")
	local size       = config.Size or UDim2.fromOffset(680, 452)

	local logo       = config.Logo or ""
	local discord    = tostring(config.Discord or "dsc.gg/senahub")
	local rawVer     = tostring(config.Version or "v1.0")
	local version    = rawVer
	if Sena.IsDonator then
		local days = Sena.DonatorInfo and tonumber(Sena.DonatorInfo.days_left)
		if not version:find("Donator") then
			version = version .. " | Donator" .. (days and (" (" .. days .. "d)") or "")
		end
	else
		if not version:find("Free") and not version:find("Donator") then
			version = version .. " | Free"
		end
	end
	local toggleKey  = config.ToggleKey or Enum.KeyCode.RightControl
	local sidebarW   = tonumber(config.SidebarWidth) or 142

	local logoIsAsset = logo:match("^rbxassetid://") ~= nil
		or logo:match("^rbxasset://") ~= nil
		or logo:match("^rbxthumb://") ~= nil
		or logo:match("^http") ~= nil
	local logoTint = config.LogoColor
		or (logoIsAsset and Color3.fromRGB(255, 255, 255) or Theme.Text)

	local Window = {}
	local Connections = {}
	Sena.Unloaded = false

	local function Track(connection)
		if connection then table.insert(Connections, connection) end
		return connection
	end

	Window.Tabs = {}
	Window.CurrentTab = nil
	Window.Flags = Sena.Flags

	pcall(function()
		local p = GuiParent()
		if p then
			for _, c in ipairs(p:GetChildren()) do
				if c.Name == "SenaUI" or c.Name == "SenaNotify" or c.Name == "SenaAnnounce" then
					pcall(function() c:Destroy() end)
				end
			end
		end
	end)

	local ScreenGui = New("ScreenGui", {
		AutoLocalize = false,  -- Roblox otomatis nerjemahin 'Join' -> 'Bergabung' dll. dan ngerusak lebar tombol
		Name = "SenaUI",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 9998,
	})
	Protect(ScreenGui)
	ScreenGui.Parent = GuiParent()
	Window.ScreenGui = ScreenGui

	local Main = New("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = size,
		BackgroundColor3 = Theme.Backdrop,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, ScreenGui)
	local WINDOW_RADIUS = 10
	Corner(Main, WINDOW_RADIUS)
	Stroke(Main, Theme.Stroke, 1)

	local Scale = New("UIScale", { Scale = 1 }, Main)

	-- Fit the window to the screen. A 700x470 panel swallows a phone outright,
	-- so scale it down (never up) until it leaves a margin on every side. The
	-- open / close animations multiply by this base so the fit survives them.
	local baseScale = 1
	local userScale = tonumber(config.Scale) or 1
	local autoFit   = config.AutoFit ~= false
	local function FitScale()
		Elevate()
		local fit = 1
		if autoFit then
			local cam = workspace.CurrentCamera
			local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
			local w = size.X.Scale * vp.X + size.X.Offset
			local h = size.Y.Scale * vp.Y + size.Y.Offset
			if w > 0 and h > 0 and vp.X > 0 and vp.Y > 0 then
				if IS_TOUCH then
					-- HP: jangan ciutin skala (teks/tombol jadi ga bisa dipegang).
					-- Kecilin ukuran window-nya sampai muat, isinya tetep 100%
					-- dan tinggal di-scroll. Tablet yang muat ga berubah.
					local maxW, maxH = vp.X * 0.92, vp.Y * 0.90
					Main.Size = UDim2.fromOffset(math.min(w, maxW), math.min(h, maxH))
					fit = 1
				else
					fit = math.min(1, (vp.X * 0.94) / w, (vp.Y * 0.94) / h)
				end
			end
		end
		baseScale = math.clamp(fit * userScale, 0.4, 1.5)
		Scale.Scale = baseScale
		return baseScale
	end
	FitScale()
	do
		local cam = workspace.CurrentCamera
		if cam then
			Track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(FitScale))
		end
	end

	local Sidebar = New("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		Size = UDim2.new(0, sidebarW, 1, -34),
	}, Main)
	RoundOuterCorner(Sidebar, WINDOW_RADIUS, "topleft")

	New("Frame", {
		Name = "SidebarDivider",
		BackgroundColor3 = Theme.StrokeSoft,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -1, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
	}, Sidebar)

	local Brand = New("Frame", {
