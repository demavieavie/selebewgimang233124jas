						local who = mine and ('<font color="#4ADE80">' .. L("You", "You") .. '</font>') or Escape(rawEntryName)
						if (mine and isLocalDonator) or (not mine and isEntryDonator) then
							who = who .. '  <font color="#F5C451"><b>[DONATOR]</b></font>'
						end
						if mine and entry.state == "claimed" then
							who = who .. '  <font color="#EAB308">· ' .. tostring(entry.partner or "?") .. " " .. L("RequestingShort", "requesting") .. "</font>"
						elseif mine and entry.state == "accepted" then
							who = who .. '  <font color="#4ADE80">· ' .. tostring(entry.partner or "?") .. " " .. L("OnTheWayShort", "on the way") .. "</font>"
