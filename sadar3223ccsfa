				local currentKey = nil
				local listening = false
				local funcs = {}

				local function SetKey(keyCode, skipCallback)
					if isLocked then return end
					Elevate()
					if typeof(keyCode) == "string" then
						local ok, enum = pcall(function() return Enum.KeyCode[keyCode] end)
						keyCode = ok and enum or nil
					end
					currentKey = keyCode
					funcs.Value = currentKey
					Bind.Text = currentKey and currentKey.Name or "None"
					Bind.TextColor3 = currentKey and Theme.Text or Theme.SubText
					if not skipCallback and currentKey then
						pcall(callback, currentKey)
					end
				end

				if isLocked then
					ApplyLockBadge(Row, TitleLabel, DescLabel, kTitle, Bind, SetExtra, Recalculate)
				else
					Bind.MouseButton1Click:Connect(function()
						Elevate()
						listening = true
						Bind.Text = "..."
						Bind.TextColor3 = Theme.Accent
					end)

					Track(UserInputService.InputBegan:Connect(function(input, processed)
						Elevate()
						if listening then
							if input.UserInputType == Enum.UserInputType.Keyboard then
								listening = false
								if input.KeyCode == Enum.KeyCode.Backspace then
									SetKey(nil, true)
								else
									SetKey(input.KeyCode, true)
								end
							end
							return
						end

						if processed or not currentKey then return end
						if input.KeyCode == currentKey then
							task.spawn(function() Elevate() pcall(callback, currentKey) end)
						end
					end))

					SetKey(default, true)
				end

				Register(Row, kTitle .. " " .. kDesc)

				function funcs:Set(keyCode) SetKey(keyCode, true) end
				function funcs:Get() return currentKey end
				function funcs:IsLocked() return isLocked end
				if flag then Sena.Flags[flag] = funcs end
				SaveState(kTitle, itemCfg, funcs,
					function() return currentKey and currentKey.Name or "" end,
					function(name) SetKey(name ~= "" and name or nil, true) end)

				return funcs
			end

