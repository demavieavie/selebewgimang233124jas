						TextSize = 12,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextYAlignment = Enum.TextYAlignment.Top,
						TextWrapped = true,
					}, Row)
				end

				local extra = 0
				local function SetExtra(value)
					extra = value or 0
				end

				local function Recalculate()
					Elevate()
					local width = Row.AbsoluteSize.X - 10 - reservedRight
					local lines = DescLabel and CountLines(rowDesc, width, Theme.FontBody, 12, 5) or 0

					if DescLabel then
						DescLabel.Size = UDim2.new(1, -10 - reservedRight, 0, lines * DESC_LINE)
					end

					local base = ROW_PAD + TITLE_H + (lines > 0 and (1 + lines * DESC_LINE) or 0) + ROW_PAD
					if lines == 0 then base = ROW_MIN end

					Row.Size = UDim2.new(1, 0, 0, base + (extraBottom or 0) + extra)
				end

				Row:GetPropertyChangedSignal("AbsoluteSize"):Connect(Recalculate)
				task.defer(Recalculate)

				return Row, TitleLabel, DescLabel, Recalculate, SetExtra
			end

