			local function SaveState(itemTitle, itemCfg, funcs, getter, setter)
				if not ConfigSystem.Enabled then return end
				if type(itemCfg) == "table"
					and (itemCfg.NoConfig == true or itemCfg.SaveConfig == false) then
					return
				end

				local configKey = (type(itemCfg) == "table" and itemCfg.Flag)
					or (key .. "/" .. secTitle .. "/" .. tostring(itemTitle))

				ConfigSystem:Register(configKey, {
					Get = getter or function() return funcs:Get() end,
					Set = setter or function(value) funcs:Set(value) end,
				})
			end

