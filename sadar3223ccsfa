local function New(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			pcall(function() inst[key] = value end)
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function Corner(parent, radius)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function Stroke(parent, color, thickness, transparency)
	return New("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function RoundOuterCorner(frame, radius, keep)
	New("UICorner", { CornerRadius = UDim.new(0, radius) }, frame)

	local function patch(position, size)
		New("Frame", {
			Name = "CornerPatch",
			BackgroundColor3 = frame.BackgroundColor3,
			BackgroundTransparency = frame.BackgroundTransparency,
			BorderSizePixel = 0,
			Position = position,
			Size = size,
			ZIndex = 0,
		}, frame)
	end

	if keep == "topleft" then
		patch(UDim2.new(0, radius, 0, 0), UDim2.new(1, -radius, 1, 0))
		patch(UDim2.new(0, 0, 0, radius), UDim2.new(0, radius, 1, -radius))
	elseif keep == "topright" then
		patch(UDim2.new(0, 0, 0, 0), UDim2.new(1, -radius, 1, 0))
		patch(UDim2.new(1, -radius, 0, radius), UDim2.new(0, radius, 1, -radius))
	elseif keep == "bottom" then
		patch(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, -radius))
	end
end

local function WatchLogo(image, fallback)
	task.spawn(function()
		Elevate()
		for _ = 1, 24 do
			if image.IsLoaded then return end
			task.wait(0.25)
		end

		if not image.IsLoaded then
			image.Visible = false
			if fallback then fallback.Visible = true end
			warn("[Sena] logo failed to load: " .. tostring(image.Image)
				.. " (use an Image asset id, not a Decal id)")
		end
	end)
end

local function LoadCustomAsset(uri)
	if not uri or uri == "" then return "" end
	uri = tostring(uri)
	if uri:match("^rbxassetid://") or uri:match("^rbxasset://") or uri:match("^rbxthumb://") then
		return uri
	end

	local getAsset = (type(getcustomasset) == "function" and getcustomasset)
		or (syn and type(syn.getcustomasset) == "function" and syn.getcustomasset)

	if uri:match("^https?://") then
		if not getAsset then
			warn("[Sena] getcustomasset not available to load web link:", uri)
			return ""
		end
		local hash = 0
		for i = 1, #uri do hash = (hash * 31 + uri:byte(i)) % 2147483647 end
		local fileName = "sena_asset_" .. tostring(hash) .. ".png"
		if isfile and isfile(fileName) then
			local ok, asset = pcall(getAsset, fileName)
			if ok and asset then return asset end
		end
		local ok, content = pcall(function() return game:HttpGet(uri) end)
		if ok and content and #content > 0 and writefile then
			pcall(writefile, fileName, content)
			local okAsset, asset = pcall(getAsset, fileName)
			if okAsset and asset then return asset end
		end
		warn("[Sena] failed to download custom asset from URL:", uri)
		return ""
	end

	if getAsset and isfile and isfile(uri) then
		local ok, asset = pcall(getAsset, uri)
		if ok and asset then return asset end
	end

	return uri
end

