local Backend = nil

-- Shared between AddFusePartner (controls) and AddFuseList (rows), which may
-- live in different sections. Old lists get dropped when their panel is gone.
local FuseCore = { lists = {}, join = nil, text = nil }

local function HttpGetJson(url)
	local ok, body = pcall(function() return game:HttpGet(url, true) end)
	if not ok or type(body) ~= "string" or body == "" then return nil end
	local okJson, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not okJson or type(data) ~= "table" then return nil end
	return data
end

local function BackendUrl(path, params)
	local parts = {}
	for key, value in pairs(params or {}) do
		parts[#parts + 1] = tostring(key) .. "=" .. HttpService:UrlEncode(tostring(value))
	end
	-- cache buster: executor HttpGet suka nyimpen respon
	parts[#parts + 1] = "t=" .. tostring(os.time()) .. tostring(math.random(1000, 9999))
	return Backend.Api .. path .. "?" .. table.concat(parts, "&")
end

local function LocalUserId()
	local ok, id = pcall(function() return LocalPlayer and LocalPlayer.UserId end)
	return tostring(ok and id or 0)
end

local function LocalUserName()
	local ok, name = pcall(function() return LocalPlayer and LocalPlayer.Name end)
	return tostring(ok and name or "")
end

-- Default kalau loader ga nyetel getgenv().SenaBackend. Nama game diambil
-- dari MarketplaceService pas loop pertama jalan (yield, jadi jangan di main thread).
local DEFAULT_BACKEND = {
	Api = "http://56.10.112.179:8080",
	Key = "sena_20VvixjHsd1OPPwgHYJAstpM",
}

local function DetectGameName()
	local ok, info = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
	end)
	if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
