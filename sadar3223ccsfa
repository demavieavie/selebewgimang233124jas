local SMOOTH = TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function Tween(object, info, props)
	if not object then return end
	local ok, tween = pcall(function()
		return TweenService:Create(object, info, props)
	end)
	if ok and tween then
		pcall(function() tween:Play() end)
		return tween
	end
	for key, value in pairs(props) do
		pcall(function() object[key] = value end)
	end
end

local function GuiParent()
	local ok, hidden = pcall(function() return gethui() end)
	if ok and hidden then return hidden end

	local okCore, coreGui = pcall(function()
		local cg = game:GetService("CoreGui")
		local _ = cg:GetChildren()
		return cg
	end)
	if okCore and coreGui then return coreGui end

	return LocalPlayer:WaitForChild("PlayerGui")
end

