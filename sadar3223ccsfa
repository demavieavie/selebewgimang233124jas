-- GET <api><path> dengan uid/key/name/game/place otomatis. Balik (data|nil, err).
function Sena:BackendCall(path, params)
	if not Backend then return nil, "not connected" end
	local isDon = (getgenv and getgenv().SenaIsDonator == true) or (_G and _G.SenaIsDonator == true) or (Sena and Sena.IsDonator == true)
	local lic = (getgenv and getgenv().SenaKey) or (_G and _G.SenaKey) or ""
	local merged = {
		uid = LocalUserId(),
		key = Backend.Key,
		name = LocalUserName(),
		display = (LocalPlayer and LocalPlayer.DisplayName) or "",
		game = Backend.Game or "",
		place = game.PlaceId,
		donator = isDon and "1" or "0",
		lic = tostring(lic or ""),
	}
	for k, v in pairs(params or {}) do merged[k] = v end
	local data = HttpGetJson(BackendUrl(path, merged))
	if not data then return nil, "no response" end
	if data.ok == false then return data, tostring(data.error or "error") end
	return data, nil
end

local ROOM_TAG_MAP = {
	id = "indonesian",
	indo = "indonesian",
	indonesia = "indonesian",
	indonesian = "indonesian",
	ph = "philippines",
	philippines = "philippines",
	filipino = "philippines",
	pinoy = "philippines",
	vn = "vietnam",
	vietnam = "vietnam",
	vietnamese = "vietnam",
	br = "brazilian",
	brazil = "brazilian",
	brazilian = "brazilian",
	brasil = "brazilian",
	gen = "general",
	general = "general",
	all = "general",
}

local ROOM_TAGS = {
	indonesian = "[ID]",
	philippines = "[PH]",
	vietnam = "[VN]",
	brazilian = "[BR]",
	general = "[GEN]",
}

local function ParseMessageRoom(msg)
	if type(msg) ~= "table" then return "general", "" end
	local text = tostring(msg.text or "")
	local tag, body = text:match("^%[([%w_]+)%]%s*(.*)$")
	local detectedRoom = nil
	if tag then
		local r = ROOM_TAG_MAP[tag:lower()]
		if r then
			detectedRoom = r
			text = body
		end
	end
	if msg.room and type(msg.room) == "string" and msg.room ~= "" then
		local r = msg.room:lower()
		if ROOM_TAG_MAP[r] then
			detectedRoom = ROOM_TAG_MAP[r]
		end
	end
	return detectedRoom or "general", text
end

function Sena:SendChat(text, room)
	if not Backend then return false, "not connected" end
	text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then return false, "empty" end

	room = tostring(room or "general"):lower()
	local tag = ROOM_TAGS[room]
	local sendText = text
	if tag and not sendText:find("^%[") and room ~= "general" then
		sendText = tag .. " " .. text
	end

	local isDon = (getgenv and getgenv().SenaIsDonator == true) or (_G and _G.SenaIsDonator == true) or (Sena and Sena.IsDonator == true)
	local lic = (getgenv and getgenv().SenaKey) or (_G and _G.SenaKey) or ""
	local data = HttpGetJson(BackendUrl("/chat/send", {
		uid = LocalUserId(),
		key = Backend.Key,
		name = LocalUserName(),
		game = Backend.Game,
		text = sendText,
		room = room,
		donator = isDon and "1" or "0",
		lic = tostring(lic or ""),
	}))
	if not data then return false, "no response" end
	if data.ok then return true end
	local err = tostring(data.error or "error")
	if err:match("^badword") then
		local minutes = err:match("^badword:(%d+)") or "?"
		local reason = "Sena: kata kasar terdeteksi di global chat. Ban " .. minutes .. " menit."
		task.delay(1.5, function() pcall(function() LocalPlayer:Kick(reason) end) end)
	end
	return false, err
end

