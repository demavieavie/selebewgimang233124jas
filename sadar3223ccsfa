function Sena:Notify(config)
	config = config or {}
	local title    = tostring(config.Title or config[1] or "Sena")
	local content  = tostring(config.Content or config.Description or config[2] or "")
	local duration = tonumber(config.Duration or config.Time or config[3]) or 4
	local icon     = config.Icon

	EnsureNotifyGui()

	local descLines = content ~= "" and CountLines(content, 216, Theme.FontBody, 12, 4) or 0
	local height = 34 + (descLines > 0 and (descLines * DESC_LINE + 6) or 0)

	local slot = New("Frame", {
		Name = "Slot",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		ClipsDescendants = false,
	}, NotifyHolder)

	local card = New("Frame", {
		Name = "Notification",
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(1, 20, 0, 0),
		BackgroundTransparency = 1,
	}, slot)
	Corner(card, 8)
	local cardStroke = Stroke(card, Theme.Stroke, 1, 1)

	local iconImage
	if icon then
		iconImage = New("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 12, 0, 11),
			Size = UDim2.new(0, 14, 0, 14),
			ImageColor3 = Theme.Text,
			ImageTransparency = 1,
		}, card)
		ApplyIcon(iconImage, icon, 48)
	end

	local textLeft = icon and 32 or 12

	local titleLabel = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, textLeft, 0, 9),
		Size = UDim2.new(1, -textLeft - 12, 0, 15),
		Font = Theme.FontBold,
		Text = title,
		TextColor3 = Theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 1,
	}, card)

	local descLabel
	if content ~= "" then
		descLabel = New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, textLeft, 0, 26),
			Size = UDim2.new(1, -textLeft - 12, 0, descLines * DESC_LINE),
			Font = Theme.FontBody,
			Text = content,
			TextColor3 = Theme.SubText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextTransparency = 1,
		}, card)
	end

	local bar = New("Frame", {
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 0.35,
	}, card)
	Corner(bar, 2)

	Tween(card, SMOOTH, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 })
	Tween(cardStroke, SMOOTH, { Transparency = 0 })
	Tween(titleLabel, SMOOTH, { TextTransparency = 0 })
	if descLabel then Tween(descLabel, SMOOTH, { TextTransparency = 0 }) end
	if iconImage then Tween(iconImage, SMOOTH, { ImageTransparency = 0 }) end
	Tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

	local closed = false
	local function close()
		if closed then return end
		closed = true
		Tween(card, QUICK, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 })
		Tween(cardStroke, QUICK, { Transparency = 1 })
		Tween(titleLabel, QUICK, { TextTransparency = 1 })
		if descLabel then Tween(descLabel, QUICK, { TextTransparency = 1 }) end
		if iconImage then Tween(iconImage, QUICK, { ImageTransparency = 1 }) end
		task.delay(0.2, function() pcall(function() slot:Destroy() end) end)
	end

	task.delay(duration, close)
	return { Close = close }
end

