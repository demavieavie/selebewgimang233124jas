	end
	return "PlaceId " .. tostring(game.PlaceId)
end

function Sena:CheckDonatorKey(customKey)
	local rawKey = customKey
		or (getgenv and (getgenv().SenaKey or (getgenv().SenaDonator and getgenv().SenaDonator.Key)))
		or (_G and _G.SenaKey)
	if type(rawKey) ~= "string" or rawKey:gsub("%s+", "") == "" then
		Sena:SetDonator(false)
		Sena.DonatorInfo = nil
		if getgenv then getgenv().SenaDonatorInfo = nil end
		return false, "no_key"
	end
	local key = rawKey:gsub("%s+", ""):upper()
	local backend = (getgenv and getgenv().SenaBackend) or (Backend or DEFAULT_BACKEND)
	local api = tostring(backend.Api or "http://56.10.112.179:8080"):gsub("/+$", "")
	local apiKey = tostring(backend.Key or "sena_20VvixjHsd1OPPwgHYJAstpM")
	local hwid = ""
	pcall(function()
		hwid = (type(gethwid) == "function" and gethwid())
			or (type(get_device_id) == "function" and get_device_id())
			or (type(getexecutorname) == "function" and getexecutorname())
			or (game:GetService("RbxAnalyticsService"):GetClientId())
			or "unknown"
	end)
	local uid = LocalUserId()
	local place = tostring(game.PlaceId or "")
	local url = string.format(
		"%s/key/check?key=%s&license=%s&hwid=%s&uid=%s&place=%s&t=%s",
		api,
		HttpService:UrlEncode(apiKey),
		HttpService:UrlEncode(key),
		HttpService:UrlEncode(hwid),
		HttpService:UrlEncode(uid),
		HttpService:UrlEncode(place),
		tostring(os.time())
	)
	local okH, raw = pcall(function() return game:HttpGet(url, true) end)
	if okH and raw then
		local okJ, res = pcall(HttpService.JSONDecode, HttpService, raw)
		if okJ and type(res) == "table" and res.ok and res.valid then
			Sena:SetDonator(true)
			Sena.DonatorInfo = res
			if getgenv then getgenv().SenaDonatorInfo = res end
			print(string.format("[SenaLib] Donator key verified: %s (%d days left)", tostring(res.name or key), tonumber(res.days_left or 0)))
			return true, res
		else
			Sena:SetDonator(false)
			Sena.DonatorInfo = nil
			if getgenv then getgenv().SenaDonatorInfo = nil end
			local reason = tostring(res and res.reason or "invalid"):lower()
			local notifyMsg = "Invalid Key. Running in Free Mode."
			if reason:find("hwid limit") then
				notifyMsg = "HWID limit reached (3/3). Running Free Version. Reset in Discord."
			elseif reason:find("expired") then
				notifyMsg = "Donator Key expired. Running Free Version."
			end
			warn("[SenaLib] " .. notifyMsg)
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "Sena - Free Mode",
					Text = notifyMsg,
					Duration = 6,
				})
			end)
			return false, reason
		end
	end
	Sena:SetDonator(false)
	return false, "network_error"
end

-- One join request row from /sync. Incoming + pending -> Accept/Decline card
-- (once per id); my own request -> teleport on accept, notify otherwise.
local function HandleJoinUpdate(this, req)
	local id = tostring(req.id or "")
	if id == "" then return end
	this.JoinSeen = this.JoinSeen or {}
	local status = tostring(req.status or "")
	local key = id .. ":" .. status
	if this.JoinSeen[key] then return end
	this.JoinSeen[key] = true
	for _, fn in ipairs(this.JoinListeners) do
		task.spawn(function() Elevate() pcall(fn, req) end)
	end
	if req.incoming then
		if status ~= "pending" then return end
		if (os.time() - (tonumber(req.ts) or 0)) > 110 then return end
		Sena:Prompt({
			Title = tostring(req.name or "Someone"),
			Content = "wants to join your server (" .. tostring(req.game or "?") .. ")",
			Avatar = tostring(req.av or ""):match("^%d+$") and req.av or nil,
			Accept = "Accept",
			Decline = "Decline",
			Duration = 60,
			Callback = function(accepted)
				if accepted == nil then return end
				local ok, err = Sena:AnswerJoin(id, accepted == true)
				if not ok then
					Sena:Notify({ Title = "Request join", Content = "Could not answer: " .. tostring(err), Duration = 4 })
				elseif accepted then
					Sena:Notify({ Title = "Request join", Content = tostring(req.name or "They") .. " is on the way to your server.", Duration = 4 })
				end
			end,
		})
	else
		if status == "accepted" then
			local place = tonumber(req.place)
			local job = tostring(req.job or "")
			if job == tostring(game.JobId) then
				Sena:Notify({ Title = "Request join", Content = "You are already in " .. tostring(req.to_name or "their") .. "'s server.", Duration = 4 })
			elseif place and job ~= "" then
				Sena:Notify({ Title = "Request join", Content = tostring(req.to_name or "They") .. " accepted. Joining their server...", Duration = 5 })
				task.delay(1.2, function()
					pcall(function()
						game:GetService("TeleportService"):TeleportToPlaceInstance(place, job, LocalPlayer)
					end)
				end)
			end
		elseif status == "declined" then
			Sena:Notify({ Title = "Request join", Content = tostring(req.to_name or "They") .. " declined.", Duration = 4 })
		elseif status == "expired" then
			Sena:Notify({ Title = "Request join", Content = tostring(req.to_name or "They") .. " did not answer.", Duration = 4 })
		end
	end
end

local function StartBackendLoop(this)
	if this.LoopAlive then return end
	this.LoopAlive = true
	task.spawn(function()
		Elevate()
		local uid = LocalUserId()
		local failures = 0
		if not this.Game or this.Game == "" then this.Game = DetectGameName() end

		-- berhenti kalau Disconnect, atau lib ini di-unload (Window:Destroy).
		-- CreateWindow berikutnya manggil ConnectBackend lagi buat nyalain ulang.
		while this.Running and not Sena.Unloaded do
			local isDon = (getgenv and getgenv().SenaIsDonator == true) or (_G and _G.SenaIsDonator == true) or (Sena and Sena.IsDonator == true)
			local lic = (getgenv and getgenv().SenaKey) or (_G and _G.SenaKey) or ""
			local params = {
				uid = uid,
				key = this.Key,
				name = LocalUserName(),
				display = (LocalPlayer and LocalPlayer.DisplayName) or "",
				donator = isDon and "1" or "0",
				lic = tostring(lic or ""),
				chat_since = this.ChatSince,
				ann_since = this.AnnSince,
				dm_since = this.DmSince,
				join_since = this.JoinSince,
				game = this.Game or "",
				place = game.PlaceId,
			}
			-- fitur lain numpang di poll yang sama (mis. fuse=1), ga bikin loop baru
			for k, v in pairs(this.Extra) do params[k] = v end
			local data = HttpGetJson(BackendUrl("/sync", params))

			if data and data.ok then
				failures = 0
				this.Connected = true
				this.Online = tonumber(data.online) or this.Online

				-- server nandain user ini kena ban chat (kata kasar) -> keluarin dari game
				if type(data.kick) == "string" and data.kick ~= "" then
					this.Running = false
					pcall(function() LocalPlayer:Kick(data.kick) end)
					return
				end
				this.ChatTtl = tonumber(data.chat_ttl) or this.ChatTtl
				this.ChatMax = tonumber(data.chat_max) or this.ChatMax
				-- server yang nentuin seberapa sering client poll (config poll_interval),
				-- biar beban bisa diturunin dari /config set tanpa upload ulang lib
				local poll = tonumber(data.poll)
				if poll then this.Interval = math.max(2, poll) end

				local cutoff = os.time() - this.ChatTtl
				while #this.History > 0 and (tonumber(this.History[1].ts) or 0) < cutoff do
					table.remove(this.History, 1)
				end

				if type(data.chat) == "table" then
					for _, msg in ipairs(data.chat) do
						local id = tonumber(msg.id) or 0
						if id > this.ChatSince then this.ChatSince = id end
						this.History[#this.History + 1] = msg
						if #this.History > 60 then table.remove(this.History, 1) end
						for _, fn in ipairs(this.Listeners) do
							task.spawn(function()
								Elevate()
								local ok, err = pcall(fn, msg)
								if not ok then warn("[Sena] chat listener error:", err) end
							end)
						end
					end
				end

				-- private messages: only rows addressed to / sent by this uid arrive
				if type(data.dm) == "table" then
					for _, msg in ipairs(data.dm) do
						local id = tonumber(msg.id) or 0
						if id > this.DmSince then this.DmSince = id end
						msg.pm = true
						this.DmHistory[#this.DmHistory + 1] = msg
						if #this.DmHistory > 60 then table.remove(this.DmHistory, 1) end
						for _, fn in ipairs(this.DmListeners) do
							task.spawn(function()
								Elevate()
								local ok, err = pcall(fn, msg)
								if not ok then warn("[Sena] dm listener error:", err) end
							end)
						end
					end
				elseif tonumber(data.dm_seq) and this.DmSince == 0 then
					this.DmSince = tonumber(data.dm_seq)
				end

				-- join requests: incoming pending -> prompt, outgoing answered -> teleport.
				-- The server replays every row newer than join_since and keeps answered
				-- rows for 15 min, so a fresh session (join_since 0, e.g. right after the
				-- teleport that the accept caused) would see its own "accepted" row again and
				-- teleport in a loop. First sync of a session: adopt the sequence, only
				-- surface incoming pending requests, never re-run old outcomes.
				local firstJoinSync = this.JoinSince == 0
				if tonumber(data.join_seq) and firstJoinSync then
					this.JoinSince = math.max(this.JoinSince, tonumber(data.join_seq))
				end
				if type(data.joins) == "table" then
					for _, req in ipairs(data.joins) do
						local ver = tonumber(req.ver) or 0
						if ver > this.JoinSince then this.JoinSince = ver end
						if not firstJoinSync or (req.incoming and tostring(req.status) == "pending") then
							task.spawn(function()
								Elevate()
								local ok, err = pcall(HandleJoinUpdate, this, req)
								if not ok then warn("[Sena] join handler error:", err) end
							end)
						else
							this.JoinSeen = this.JoinSeen or {}
							this.JoinSeen[tostring(req.id or "") .. ":" .. tostring(req.status or "")] = true
						end
					end
				end

				if data.fuse ~= nil then
					for _, fn in ipairs(this.FuseListeners) do
						task.spawn(function()
							Elevate()
							local ok, err = pcall(fn, data.fuse)
							if not ok then warn("[Sena] fuse listener error:", err) end
						end)
					end
				end

				local annSeq = tonumber(data.ann_seq)
				if annSeq then
					if this.AnnSince < 0 then
						this.AnnSince = annSeq
					elseif type(data.ann) == "table" then
						for _, ann in ipairs(data.ann) do
							local id = tonumber(ann.id) or 0
							if id > this.AnnSince then this.AnnSince = id end
							if this.Announcements then
								Sena:Announce({
									Title = ann.title,
									Content = ann.text,
									Duration = tonumber(ann.duration) or 15,
									Sound = ann.sound,
								})
							end
						end
					end
				end
			else
				failures = failures + 1
				this.Connected = false
			end

			local wait = this.Interval
			if failures > 0 then wait = math.min(30, this.Interval * (1 + failures)) end
			task.wait(wait)
		end
		this.LoopAlive = false
		this.Connected = false
	end)
end

function Sena:ConnectBackend(config)
	config = config or {}
	if config.Disabled then return nil end

	if not Backend then
		local api = tostring(config.Api or DEFAULT_BACKEND.Api or ""):gsub("/+$", "")
		if api == "" then
			warn("[Sena] ConnectBackend: Api kosong")
			return nil
		end
		Backend = {
			Api = api,
			Key = tostring(config.Key or DEFAULT_BACKEND.Key or ""),
			Game = config.Game and tostring(config.Game) or nil,
			Interval = math.max(2, tonumber(config.Interval) or 3),
			Announcements = config.Announcements ~= false,
			ChatSince = 0,
			AnnSince = -1,
			ChatTtl = 600,
			ChatMax = 120,
			Online = 0,
			Running = true,
			Connected = false,
			LoopAlive = false,
			Listeners = {},
			FuseListeners = {},
			DmListeners = {},
			JoinListeners = {},
			DmSince = 0,
			JoinSince = 0,
			DmHistory = {},
			Extra = {},
			History = {},
		}
	else
		if config.Api then Backend.Api = tostring(config.Api):gsub("/+$", "") end
		if config.Key then Backend.Key = tostring(config.Key) end
		if config.Game then Backend.Game = tostring(config.Game) end
		if config.Interval then Backend.Interval = math.max(2, tonumber(config.Interval) or Backend.Interval) end
		if config.Announcements ~= nil then Backend.Announcements = config.Announcements ~= false end
		Backend.Running = true
	end

	StartBackendLoop(Backend)
	return Backend
end

function Sena:GetBackend() return Backend end

function Sena:DisconnectBackend()
	if Backend then Backend.Running = false end
end

function Sena:OnChat(fn)
	if not Backend or type(fn) ~= "function" then return false end
	Backend.Listeners[#Backend.Listeners + 1] = fn
	return true
end

