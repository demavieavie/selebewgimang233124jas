local function GetExecutorName()
	local ok, name = pcall(function()
		if identifyexecutor then
			return (identifyexecutor())
		end
		if getexecutorname then
			return getexecutorname()
		end
		return nil
	end)

	name = ok and name and tostring(name) or ""
	name = name:gsub("^%s+", ""):gsub("%s+$", "")

	if name == "" then
		return RunService:IsStudio() and "Studio" or "Unknown"
	end

	return name
end

local function CopyToClipboard(text)
	local fn = setclipboard or toclipboard or writeclipboard
	if type(fn) ~= "function" then return false end
	return (pcall(fn, tostring(text)))
end

local function ReadClipboard()
	local fn = getclipboard or getclipboardtext or readclipboard
	if type(fn) ~= "function" then return nil end

	local ok, value = pcall(fn)
	if ok and type(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

local function CanReadClipboard()
	return type(getclipboard) == "function"
		or type(getclipboardtext) == "function"
		or type(readclipboard) == "function"
end

local LUCIDE_URL =
	"https://raw.githubusercontent.com/latte-soft/lucide-roblox/master/lib/Icons.luau"

local IconPack, IconPackTried = nil, false

local function GetIconPack()
	if IconPackTried then return IconPack end
	IconPackTried = true

	local okCache, cached = pcall(function()
		return getgenv().SenaLucideIcons
	end)
	if okCache and type(cached) == "table" then
		IconPack = cached
		return IconPack
	end

	pcall(function()
		local source = game:HttpGet(LUCIDE_URL)
		if type(source) == "string" and #source > 1000 then
			local chunk = loadstring(source)
			if chunk then
				local ok, result = pcall(chunk)
				if ok and type(result) == "table" then
					IconPack = result
				end
			end
		end
	end)

	if IconPack then
		pcall(function() getgenv().SenaLucideIcons = IconPack end)
	end

	return IconPack
end

local function LucideAsset(name, size)
	local pack = GetIconPack()
	if not pack then return nil end

	local set = pack[tostring(size or 48) .. "px"] or pack["48px"] or pack["256px"]
	local entry = set and set[name]
	if type(entry) ~= "table" then return nil end

	local rect, offset = entry[2], entry[3]
	return "rbxassetid://" .. tostring(entry[1]),
		Vector2.new(offset and offset[1] or 0, offset and offset[2] or 0),
		Vector2.new(rect and rect[1] or 0, rect and rect[2] or 0)
end

