local function ResolveAnnounceSound(value)
	if value == false then return nil end
	local text = tostring(value == nil and "default" or value):lower()
	if text == "off" or text == "none" or text == "false" or text == "0" then return nil end
	if text == "default" or text == "true" or text == "" then return ANNOUNCE_SOUND end
	return tostring(value)
end

