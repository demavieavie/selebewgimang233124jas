						btn.MouseLeave:Connect(function() Elevate() Tween(btn, QUICK, { BackgroundColor3 = restColor }) end)

						local clickDebounce = false
						local function doClick()
							if clickDebounce then return end
							clickDebounce = true
							task.delay(0.35, function() clickDebounce = false end)
							if mine then
								if FuseCore.stop then FuseCore.stop() end
							elseif FuseCore.join then
								FuseCore.join(entry, function(status, extra)
									if not (btn and btn.Parent) then return end
									if status == "need_pet" then
										btn.Text = L("NoPetShort", "No Pet!")
										btn.BackgroundColor3 = Theme.Destructive or Color3.fromRGB(220, 60, 60)
										task.delay(1.6, function()
											if btn and btn.Parent then
												btn.Text = L("Join", "Join")
												btn.BackgroundColor3 = restColor
											end
										end)
									elseif status == "busy" then
										btn.Text = L("WaitShort", "Wait...")
										task.delay(1, function()
											if btn and btn.Parent then
												btn.Text = L("Join", "Join")
											end
										end)
									elseif status == "claiming" then
										btn.Text = "..."
									elseif status == "error" then
										btn.Text = "Error"
										task.delay(1.5, function()
											if btn and btn.Parent then
												btn.Text = L("Join", "Join")
											end
										end)
									end
								end)
							end
						end
						btn.Activated:Connect(doClick)
						OnTap(btn, doClick)
						rows[#rows + 1] = row
					end
				end

				local handle = {}
