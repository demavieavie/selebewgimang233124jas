	local SearchEntries = {}

	local function Normalize(text)
		return string.lower(tostring(text or ""))
	end

	local function RegisterSearch(row, section, tabKey, text)
		table.insert(SearchEntries, {
			Row = row,
			Section = section,
			TabKey = tabKey,
			Text = Normalize(text),
		})
	end

	local function RunSearch()
		Elevate()
		local query = Normalize(SearchBox.Text)
		local sectionsSeen = {}

		for _, entry in ipairs(SearchEntries) do
			if entry.TabKey == Window.CurrentTab then
				local match = query == "" or entry.Text:find(query, 1, true) ~= nil
				entry.Row.Visible = match
				if entry.Section then
					sectionsSeen[entry.Section] = (sectionsSeen[entry.Section] or false) or match
				end
			end
		end

		for section, anyMatch in pairs(sectionsSeen) do
			section.Frame.Visible = (query == "") or anyMatch
			if query ~= "" and anyMatch and not section.Open then
				section:SetOpen(true, true)
			end
		end
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(RunSearch)

	local TabOrder = 0
	local TabButtons = {}

	local function SelectTab(key)
		Elevate()
		for tabKey, tab in pairs(Window.Tabs) do
			local active = tabKey == key
			tab.Page.Visible = active

			local button = TabButtons[tabKey]
			if button then
				Tween(button.Frame, QUICK, {
					BackgroundTransparency = active and 0 or 1,
				})
				Tween(button.Label, QUICK, {
					TextColor3 = active and Theme.Text or Theme.SubText,
				})
				Tween(button.Icon, QUICK, {
					ImageColor3 = active and Theme.Text or Theme.Dim,
				})
				Tween(button.Marker, QUICK, {
					BackgroundTransparency = active and 0 or 1,
					Size = UDim2.new(0, 2, 0, active and 14 or 4),
				})
			end

			if active then
				local switched = Window.CurrentTab ~= tabKey
				Window.CurrentTab = tabKey
				PageTitle.Text = tab.Title
				PageDesc.Text = tab.Description
				PageDesc.Visible = tab.Description ~= ""
				PageTitle.Position = UDim2.new(0, 16, 0, tab.Description ~= "" and 9 or 16)
				if switched then
					-- slide the page up 14 px into place and fade the heading in
					tab.Page.Position = UDim2.new(0, 0, 0, 14)
					Tween(tab.Page, SMOOTH, { Position = UDim2.new(0, 0, 0, 0) })
					PageTitle.TextTransparency = 1
					PageDesc.TextTransparency = 1
					Tween(PageTitle, SMOOTH, { TextTransparency = 0 })
					Tween(PageDesc, SMOOTH, { TextTransparency = 0 })
					if button then
						button.Icon.Size = UDim2.new(0, 11, 0, 11)
						Tween(button.Icon, SMOOTH, { Size = UDim2.new(0, 14, 0, 14) })
					end
				end
			end
		end

		RunSearch()
	end

