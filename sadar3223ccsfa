	task.delay(duration, close)
	return { Close = close }
end

-- Notification-style card with an avatar and two buttons (Accept / Decline).
-- Used for "X requests to join your server"; resolves the callback once.
--   Sena:Prompt({ Title, Content, Avatar = <userId>, Accept = "Accept",
--                 Decline = "Decline", Duration = 60, Callback = function(accepted) end })
function Sena:Prompt(config)
	config = config or {}
	local title    = tostring(config.Title or "Sena")
	local content  = tostring(config.Content or "")
	local duration = math.max(5, tonumber(config.Duration) or 60)
	local avatar   = config.Avatar
	local callback = config.Callback
	local acceptLabel  = tostring(config.Accept or "Accept")
	local declineLabel = tostring(config.Decline or "Decline")

	EnsureNotifyGui()

	local AV = 34
	local textLeft = avatar and (12 + AV + 10) or 14
	local descLines = content ~= "" and CountLines(content, 270 - textLeft - 12, Theme.FontBody, 12, 4) or 0
	local BTN_H = 26
	local height = 12 + 16 + (descLines > 0 and (descLines * DESC_LINE + 4) or 0) + 8 + BTN_H + 10

	local slot = New("Frame", {
		Name = "Slot",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		ClipsDescendants = false,
	}, NotifyHolder)

	local card = New("Frame", {
		Name = "Prompt",
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(1, 20, 0, 0),
		BackgroundTransparency = 1,
	}, slot)
	Corner(card, 8)
	local cardStroke = Stroke(card, Theme.Stroke, 1, 1)

	local pic
	if avatar then
		local ring = New("Frame", {
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 12, 0, 12),
			Size = UDim2.new(0, AV, 0, AV),
		}, card)
		Corner(ring, AV / 2)
		pic = New("ImageLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(avatar) .. "&w=60&h=60",
			ImageTransparency = 1,
		}, ring)
		Corner(pic, AV / 2)
	end

	local titleLabel = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, textLeft, 0, 12),
		Size = UDim2.new(1, -textLeft - 12, 0, 16),
		Font = Theme.FontBold,
		RichText = true,
		Text = title,
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
	}, card)
	local descLabel
	if content ~= "" then
		descLabel = New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, textLeft, 0, 29),
			Size = UDim2.new(1, -textLeft - 12, 0, descLines * DESC_LINE),
			Font = Theme.FontBody,
			Text = content,
			TextColor3 = Theme.SubText,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextTransparency = 1,
		}, card)
	end

	local btnTop = height - 10 - BTN_H
	local function makeButton(label, x, w, accent)
		local b = New("TextButton", {
			Active = true,
			Position = UDim2.new(0, x, 0, btnTop),
			Size = UDim2.new(0, w, 0, BTN_H),
			BackgroundColor3 = accent and Theme.Accent or Theme.Element,
			BorderSizePixel = 0,
			Font = Theme.FontBold,
			Text = label,
			TextColor3 = accent and Theme.AccentText or Theme.Text,
			TextSize = 12,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			TextTransparency = 1,
		}, card)
		Corner(b, 7)
		if not accent then Stroke(b, Theme.StrokeSoft, 1) end
		return b
	end
	local half = math.floor((270 - textLeft - 12 - 6) / 2)
	local acceptBtn  = makeButton(acceptLabel, textLeft, half, true)
	local declineBtn = makeButton(declineLabel, textLeft + half + 6, half, false)

	local bar = New("Frame", {
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 0.35,
	}, card)
	Corner(bar, 2)

	local POP = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	Tween(card, POP, { Position = UDim2.new(0, 0, 0, 0) })
	Tween(card, SMOOTH, { BackgroundTransparency = 0 })
	Tween(cardStroke, SMOOTH, { Transparency = 0 })
	Tween(titleLabel, SMOOTH, { TextTransparency = 0 })
	if descLabel then Tween(descLabel, SMOOTH, { TextTransparency = 0 }) end
	if pic then Tween(pic, SMOOTH, { ImageTransparency = 0 }) end
	for _, b in ipairs({ acceptBtn, declineBtn }) do
		Tween(b, SMOOTH, { BackgroundTransparency = 0, TextTransparency = 0 })
	end
	Tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

	local closed = false
	local function close()
		Elevate()
		if closed then return end
		closed = true
		Tween(card, QUICK, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 })
		Tween(cardStroke, QUICK, { Transparency = 1 })
		Tween(titleLabel, QUICK, { TextTransparency = 1 })
		if descLabel then Tween(descLabel, QUICK, { TextTransparency = 1 }) end
		if pic then Tween(pic, QUICK, { ImageTransparency = 1 }) end
		task.delay(0.2, function() Elevate() pcall(function() slot:Destroy() end) end)
	end
	local answered = false
	local function answer(accepted)
		Elevate()
		if answered then return end
		answered = true
		close()
		if type(callback) == "function" then
			task.spawn(function()
				Elevate()
				local ok, err = pcall(callback, accepted)
				if not ok then warn("[Sena] Prompt callback error:", err) end
			end)
		end
	end
	OnTap(acceptBtn, function() answer(true) end)
	OnTap(declineBtn, function() answer(false) end)
	for _, b in ipairs({ acceptBtn, declineBtn }) do
		local rest = b == acceptBtn and Theme.Accent or Theme.Element
		b.MouseEnter:Connect(function() Elevate() Tween(b, QUICK, { BackgroundColor3 = b == acceptBtn and Color3.fromRGB(255, 255, 255) or Theme.ElementHover }) end)
		b.MouseLeave:Connect(function() Elevate() Tween(b, QUICK, { BackgroundColor3 = rest }) end)
	end

	task.delay(duration, function() if not answered then answer(nil) end end)
	return { Close = close, Answer = answer }
end

