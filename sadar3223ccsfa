				local function ClearRows()
					for _, r in ipairs(rows) do pcall(function() r:Destroy() end) end
					rows = {}
				end

				local function Rebuild(list)
					ClearRows()
					local others = 0
					for _, e in ipairs(list) do if not e.mine then others += 1 end end
					Empty.Visible = #list == 0
					Count.Text = others > 0 and tostring(others) or ""
					local JOIN_W = IS_TOUCH and 64 or 54
