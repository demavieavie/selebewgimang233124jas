	function Window:LoadConfig(name) return ConfigSystem:Load(name) end
	function Window:DeleteConfig(name) return ConfigSystem:Delete(name) end
	function Window:GetConfigs() return ConfigSystem:GetConfigs() end
	function Window:SetAutoLoadConfig(name, enabled)
