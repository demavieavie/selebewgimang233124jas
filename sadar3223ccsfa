	local ConfigSystem
	do
		local HasFiles = type(writefile) == "function"
			and type(readfile) == "function"
			and type(isfile) == "function"
			and type(isfolder) == "function"
			and type(makefolder) == "function"
			and type(listfiles) == "function"

		local function Sanitize(name)
			return (tostring(name or "")
				:gsub("[\\/:*?\"<>|]", "")
				:gsub("^%s+", "")
				:gsub("%s+$", ""))
		end

		local gameKey = "0"
		pcall(function()
			gameKey = tostring(game.GameId ~= 0 and game.GameId or game.PlaceId)
		end)

		local folderTitle = Sanitize(title)
		local folder = tostring(config.ConfigFolder
			or ("Sena/" .. (folderTitle ~= "" and folderTitle or "Hub") .. "/" .. gameKey))

		ConfigSystem = {
			Enabled = config.SaveConfig ~= false,
			Folder = folder,
			HasFiles = HasFiles,
			Elements = {},
			Order = {},
			Pending = nil,
			Current = "",
			Memory = {},
			MemoryAutoLoad = "",
		}

		local autoLoadPath = folder .. "/autoload.txt"
		local function ConfigPath(name)
			return folder .. "/configs/" .. name .. ".json"
		end

		local function EnsureFolders()
			if not HasFiles then return false end
			return (pcall(function()
				local path = ""
				for part in (folder .. "/configs"):gmatch("[^/\\]+") do
					path = path == "" and part or (path .. "/" .. part)
					if not isfolder(path) then makefolder(path) end
				end
			end))
		end

		function ConfigSystem:Register(key, funcs)
			if not key or key == "" or self.Elements[key] then return end

			self.Elements[key] = funcs
			table.insert(self.Order, key)

			if self.Pending ~= nil and self.Pending[key] ~= nil then
				task.spawn(function()
					pcall(funcs.Set, self.Pending[key])
				end)
			end
		end

		function ConfigSystem:Collect()
			local data = {}
			for _, key in ipairs(self.Order) do
				local funcs = self.Elements[key]
				if funcs then
					local ok, value = pcall(funcs.Get)
					if ok and value ~= nil then data[key] = value end
				end
			end
			return data
		end

		function ConfigSystem:Apply(data)
			if type(data) ~= "table" then return false end
			self.Pending = data

			for _, key in ipairs(self.Order) do
				local funcs = self.Elements[key]
				local value = data[key]
				if funcs and value ~= nil then
					task.spawn(function()
						pcall(funcs.Set, value)
					end)
				end
			end

			return true
		end

		function ConfigSystem:GetConfigs()
			local list = {}

			if HasFiles then
				pcall(function()
					EnsureFolders()
					for _, path in ipairs(listfiles(folder .. "/configs")) do
						local name = tostring(path):match("([^/\\]+)%.json$")
						if name then table.insert(list, name) end
					end
				end)
			else
				for name in pairs(self.Memory) do
					table.insert(list, name)
				end
			end

			table.sort(list)
			return list
		end

		function ConfigSystem:Save(name)
			name = Sanitize(name)
			if name == "" then return false, "Name is empty." end

			local ok, encoded = pcall(function()
				return HttpService:JSONEncode({ Name = name, Data = self:Collect() })
			end)
			if not ok then return false, "Failed to encode config." end

			if HasFiles then
				EnsureFolders()
				local written = pcall(function()
					writefile(ConfigPath(name), encoded)
				end)
				if not written then return false, "Failed to write file." end
			else
				self.Memory[name] = encoded
			end

			self.Current = name
			return true
		end

		function ConfigSystem:Read(name)
			name = Sanitize(name)
			if name == "" then return nil end

			local raw
			if HasFiles then
				local ok, contents = pcall(function()
					if isfile(ConfigPath(name)) then return readfile(ConfigPath(name)) end
					return nil
				end)
				raw = ok and contents or nil
			else
				raw = self.Memory[name]
			end

			if not raw then return nil end

			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if not ok or type(decoded) ~= "table" then return nil end

			return type(decoded.Data) == "table" and decoded.Data or decoded
		end

		function ConfigSystem:Load(name)
			local data = self:Read(name)
			if not data then return false, "Config not found." end

			self.Current = Sanitize(name)
			self:Apply(data)
			return true
		end

		function ConfigSystem:Delete(name)
			name = Sanitize(name)
			if name == "" then return false end

			local removed = false
			if HasFiles then
				pcall(function()
					if isfile(ConfigPath(name)) then
						if type(delfile) == "function" then
							delfile(ConfigPath(name))
						else
							writefile(ConfigPath(name), "")
						end
						removed = true
					end
				end)
			elseif self.Memory[name] then
				self.Memory[name] = nil
				removed = true
			end

			if removed and self:GetAutoLoad() == name then
				self:SetAutoLoad(name, false)
			end
			if self.Current == name then self.Current = "" end

			return removed
		end

		function ConfigSystem:GetAutoLoad()
			if not HasFiles then return self.MemoryAutoLoad end

			local ok, contents = pcall(function()
				if isfile(autoLoadPath) then return readfile(autoLoadPath) end
				return ""
			end)
			return ok and Sanitize(contents) or ""
		end

		function ConfigSystem:SetAutoLoad(name, enabled)
			name = Sanitize(name)
			local value = enabled and name or ""

			if not HasFiles then
				self.MemoryAutoLoad = value
				return true
			end

			EnsureFolders()
			return (pcall(function() writefile(autoLoadPath, value) end))
		end

		function ConfigSystem:Export()
			local ok, encoded = pcall(function()
				return HttpService:JSONEncode(self:Collect())
			end)
			return ok and encoded or nil
		end

		function ConfigSystem:Import(text)
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(tostring(text or ""))
			end)
			if not ok or type(decoded) ~= "table" then return false end
			return self:Apply(type(decoded.Data) == "table" and decoded.Data or decoded)
		end
	end

	Window.ConfigSystem = ConfigSystem

