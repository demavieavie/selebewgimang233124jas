					Elevate()
					for optionName, entry in pairs(rows) do
						local on = selected[optionName] == true
						Tween(entry.Frame, QUICK, {
							BackgroundColor3 = on and Theme.ElementHover or Theme.Element,
						})
						Tween(entry.Label, QUICK, {
							TextColor3 = on and Theme.Text or Theme.SubText,
						})
						entry.Check.Visible = on
					end
				end

				local function FireCallback()
					local list = SelectedList()
					funcs.Value = multi and list or (list[1] or "")
					task.spawn(function()
						Elevate()
						local ok, err = pcall(callback, multi and list or (list[1] or ""))
						if not ok then warn("[Sena] Dropdown callback error:", err) end
					end)
				end

				local function ListHeight()
					local count = #options
					if count == 0 then return 30 end
					local visible = math.min(count, maxList)
					return visible * OPT_H + (visible - 1) * 3 + 8
