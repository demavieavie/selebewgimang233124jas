					if s == sig then return end
					sig = s
					Rebuild(list)
				end
				FuseCore.lists[#FuseCore.lists + 1] = handle

				Register(Panel, L("ListTitle", "Players looking for a partner"))
				local funcs = {}
				function funcs:Clear() sig = "" Rebuild({}) end
				return funcs
