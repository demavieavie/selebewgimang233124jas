				local selected = {}
				local isOpen = false
				local funcs = { Value = multi and {} or "", Options = options }

				local function SelectedList()
					local list = {}
					for _, option in ipairs(options) do
						if selected[tostring(option)] then
							table.insert(list, tostring(option))
						end
					end
					return list
				end

				local function UpdateLabel()
					local list = SelectedList()
					if #list == 0 then
						ControlLabel.Text = "---"
						ControlLabel.TextColor3 = Theme.Dim
					else
						ControlLabel.Text = table.concat(list, ", ")
						ControlLabel.TextColor3 = Theme.Text
