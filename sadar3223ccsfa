local SetIdentity = nil
do
	local ok = pcall(function() return setthreadidentity end)
	if ok and type(setthreadidentity) == "function" then
		SetIdentity = setthreadidentity
	elseif syn and type(syn.set_thread_identity) == "function" then
		SetIdentity = syn.set_thread_identity
	end
end

-- Signal handlers and task.defer callbacks resume on threads that inherit the
-- caller's identity. When a hub builds its UI from an unelevated thread those
-- callbacks lose the capability to touch Instances at all, so reading
-- AbsoluteSize raises "cannot access 'Instance'". Re-assert before touching GUI.
local function Elevate()
	if SetIdentity then pcall(SetIdentity, 8) end
end


