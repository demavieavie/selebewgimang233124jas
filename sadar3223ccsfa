				local function Help()
					SystemLine("Commands:")
					SystemLine("/help - this list")
					SystemLine("/pm <player> [message] - private message (switches you to PM mode)")
					SystemLine("/global or /gen - switch to General room")
					SystemLine("/id - switch to Indonesian room")
					SystemLine("/ph - switch to Philippines room")
					SystemLine("/vn - switch to Vietnam room")
					SystemLine("/br - switch to Brazilian room")
					SystemLine("/requestjoin <player> - ask to join their server")
					SystemLine("/accept  /decline - answer the latest join request")
					SystemLine("Tip: Click the category tabs at the top to change room.")
				end

				-- returns text to send (or nil when the command was fully handled)
				local function RunCommand(text)
					local cmd, rest = text:match("^/(%w+)%s*(.*)$")
					if not cmd then return text end
					cmd = cmd:lower()
					if cmd == "help" or cmd == "h" or cmd == "cmd" then
						Help()
						return nil
					elseif cmd == "global" or cmd == "g" or cmd == "all" or cmd == "gen" or cmd == "general" then
						SwitchRoom("general")
						SetMode("global")
						SystemLine("General room")
						return nil
					elseif cmd == "id" or cmd == "indo" or cmd == "indonesia" or cmd == "indonesian" then
						SwitchRoom("indonesian")
						SetMode("global")
						SystemLine("Indonesian room")
						return nil
					elseif cmd == "ph" or cmd == "philippines" or cmd == "filipino" or cmd == "pinoy" then
						SwitchRoom("philippines")
						SetMode("global")
						SystemLine("Philippines room")
						return nil
					elseif cmd == "vn" or cmd == "vietnam" or cmd == "vietnamese" then
						SwitchRoom("vietnam")
						SetMode("global")
						SystemLine("Vietnam room")
						return nil
					elseif cmd == "br" or cmd == "brazil" or cmd == "brazilian" or cmd == "brasil" then
						SwitchRoom("brazilian")
						SetMode("global")
						SystemLine("Brazilian room")
						return nil
					elseif cmd == "pm" or cmd == "w" or cmd == "msg" or cmd == "dm" then
						local who, body = rest:match("^(%S+)%s*(.*)$")
						if not who then
							SystemLine("Usage: /pm <player> [message]")
							return nil
						end
						SetMode("pm", who)
						if body == "" then
							SystemLine("PM mode: everything you type now goes to " .. tostring(pmTarget))
							return nil
						end
						return body
					elseif cmd == "requestjoin" or cmd == "rj" or cmd == "join" then
						local cleanRest = rest:gsub("^[%.%s@\"']+", ""):gsub("[\"']+$", "")
						local who = cleanRest:match("^(%S+)")
						if not who or who == "" then
							SystemLine("Usage: /requestjoin <player username or display name>")
							return nil
						end
						task.spawn(function()
							Elevate()
							local ok, res = Sena:RequestJoin(who)
							if ok then
								SystemLine("Asked " .. tostring(res or who) .. " to join their server. Waiting for the answer...")
							else
								SystemLine("Request join failed: " .. tostring(res))
							end
						end)
						return nil
					elseif cmd == "accept" or cmd == "decline" or cmd == "deny" then
						if not lastIncoming then
							SystemLine("No join request waiting")
							return nil
						end
						local id = lastIncoming
						lastIncoming = nil
						local accept = cmd == "accept"
						task.spawn(function()
							Elevate()
							local ok, err = Sena:AnswerJoin(id, accept)
							if ok then
								SystemLine(accept and "Accepted, they are on the way." or "Declined.")
							else
								SystemLine("Could not answer: " .. tostring(err))
							end
						end)
						return nil
					end
					SystemLine("Unknown command. /help")
					return nil
				end

				local function Submit()
					Elevate()
					if sending then return end
					local text = Box.Text:gsub("^%s+", ""):gsub("%s+$", "")
					if text == "" then return end
					if text:sub(1, 1) == "/" then
						local out = RunCommand(text)
						Box.Text = ""
						if not out or out == "" then return end
						text = out
					end
					local limit = MaxLength()
					if #text > limit then
						text = text:sub(1, limit)
					end

					local remaining = cooldown - (os.clock() - lastSent)
					if remaining > 0 then
						SystemLine("Wait " .. tostring(math.ceil(remaining)) .. "s before sending again")
						return
					end

					sending = true
					SetSend(false, "...")
					local sendRoom = activeRoom
					task.spawn(function()
						Elevate()
						local ok, err
						if mode == "pm" then
							ok, err = Sena:SendDM(pmTarget, text)
						else
							ok, err = Sena:SendChat(text, sendRoom)
						end
						if ok then
							lastSent = os.clock()
							Box.Text = ""
							Countdown(cooldown)
						else
							err = tostring(err or "")
							local wait = err:match("^cooldown:(%d+)")
							if wait then
								SystemLine("Slow down, " .. wait .. "s left")
								Countdown(tonumber(wait) or cooldown)
							elseif err == "no response" then
								SystemLine("Chat server not reachable")
							else
								SystemLine("Failed to send: " .. err)
							end
						end
						sending = false
						if Row.Parent then SetSend(true, "Send") end
					end)
				end

				Box.Focused:Connect(function()
					Elevate()
					Tween(Box, QUICK, { BackgroundColor3 = Theme.Backdrop })
				end)
				Box.FocusLost:Connect(function(enterPressed)
					Elevate()
					Tween(Box, QUICK, { BackgroundColor3 = Theme.Card })
					if enterPressed then Submit() end
				end)
				Box:GetPropertyChangedSignal("Text"):Connect(function()
					local limit = MaxLength()
					if #Box.Text > limit then
						Box.Text = Box.Text:sub(1, limit)
					end
				end)

				Send.MouseEnter:Connect(function()
					Elevate()
					if Send.Active then Tween(Send, QUICK, { BackgroundTransparency = 0.12 }) end
				end)
				Send.MouseLeave:Connect(function()
					Elevate()
					Tween(Send, QUICK, { BackgroundTransparency = 0 })
				end)
				Send.MouseButton1Click:Connect(Submit)

				local backend = Sena:GetBackend()
				if not backend then
					local ok, cfg = pcall(function() return getgenv and getgenv().SenaBackend end)
					backend = Sena:ConnectBackend((ok and type(cfg) == "table") and cfg or {})
				end
				if not backend then
					SystemLine("Not connected. Call Sena:ConnectBackend({ Api = ..., Key = ..., Game = ... }) first.")
					SetSend(false, "Send")
				else
					for _, msg in ipairs(backend.History) do Append(msg) end
					for _, msg in ipairs(backend.DmHistory or {}) do Append(msg) end
					Sena:OnChat(function(msg)
						if Row.Parent then Append(msg) end
					end)
					Sena:OnDM(function(msg)
						if Row.Parent then Append(msg) end
					end)
					Sena:OnJoin(function(req)
						if not Row.Parent then return end
						local status = tostring(req.status or "")
						if req.incoming then
							if status == "pending" then
								lastIncoming = req.id
								SystemLine(tostring(req.name or "Someone") .. " wants to join your server - /accept or /decline (or use the popup)")
							end
						elseif status == "accepted" then
							SystemLine(tostring(req.to_name or "They") .. " accepted your request, teleporting...")
						elseif status == "declined" then
							SystemLine(tostring(req.to_name or "They") .. " declined your request")
						elseif status == "expired" then
							SystemLine(tostring(req.to_name or "They") .. " did not answer")
						end
					end)

					task.spawn(function()
						Elevate()
						local tick = 0
						while Row.Parent and not Sena.Unloaded do
							if backend.Connected then
								OnlineLabel.Text = '<font color="#4ADE80">●</font>  ' .. tostring(backend.Online) .. " online"
								OnlineLabel.TextColor3 = Theme.SubText
							else
								OnlineLabel.Text = '<font color="#F87171">●</font>  reconnecting'
								OnlineLabel.TextColor3 = Theme.Dim
							end
							tick = tick + 1
							if tick % 10 == 0 then Expire() end  -- tiap 20 detik
							task.wait(2)
						end
					end)
				end

