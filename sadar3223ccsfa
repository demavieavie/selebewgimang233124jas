local function ApplyIcon(image, name, size)
	if not image then return end
	name = tostring(name or "")

	if name == "" then
		image.Image = ""
		return
	end

	if name:match("^rbxassetid://") or name:match("^rbxasset://") or name:match("^http") then
		image.Image = name
		image.ImageRectOffset = Vector2.new(0, 0)
		image.ImageRectSize = Vector2.new(0, 0)
		return
	end

	local assetId, rectOffset, rectSize = LucideAsset(name, size or 48)
	if assetId then
		image.Image = assetId
		image.ImageRectOffset = rectOffset
		image.ImageRectSize = rectSize
		return
	end

	image.Image = FallbackIcons[name] or FallbackIcons[name:gsub("_", "-")] or ""
	image.ImageRectOffset = Vector2.new(0, 0)
	image.ImageRectSize = Vector2.new(0, 0)
end

