						local side = tostring(entry.side or "?")
						local sideHex = side == "Light" and "#F5C451" or (side == "Dark" and "#B48CFF" or "#A2A2AE")
						local mine = entry.mine == true
						if mine then
							row.BackgroundColor3 = Theme.Element
							Stroke(row, Theme.Stroke, 1)
						end
						local isLocalDonator = (getgenv and getgenv().SenaIsDonator == true) or (Sena and Sena.IsDonator == true)
						local isEntryDonator = (entry.donator == true) or (tostring(entry.name or ""):find("%[DONATOR%]") ~= nil)
