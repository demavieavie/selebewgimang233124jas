					Stroke(badge, Theme.StrokeSoft, 1)

					local r = { frame = row, Who = Who, Sub = Sub, Status = Status, StatusSub = StatusSub, btn = btn, badge = badge, entry = entry, rest = Theme.Accent }
					btn.MouseEnter:Connect(function() if r.entry.disabled then return end Elevate() Tween(btn, QUICK, { BackgroundColor3 = Color3.fromRGB(255, 255, 255) }) end)
					btn.MouseLeave:Connect(function() Elevate() Tween(btn, QUICK, { BackgroundColor3 = r.rest }) end)
					local clickDebounce = false
					local function doClick()
						if isLocked or clickDebounce or r.entry.disabled then return end
						clickDebounce = true
						task.delay(0.35, function() clickDebounce = false end)
						local fn = r.entry.onClick
						if type(fn) ~= "function" then return end
						task.spawn(function()
							Elevate()
							local ok, err = pcall(fn, r.entry, function(label, color)
								if not (btn and btn.Parent) then return end
								if label ~= nil then btn.Text = tostring(label) end
								if color ~= nil then btn.BackgroundColor3 = badgeColor(color) end
							end)
							if not ok then warn("[Sena] ActionList callback error:", err) end
						end)
					end
					btn.Activated:Connect(doClick)
					OnTap(btn, doClick)
					return r
				end

				local NARROW_W = 400
				local function ApplyRow(r, entry, order)
					r.entry = entry
					r.frame.LayoutOrder = order
					local hasMid = (entry.status or entry.statusSub) ~= nil
					local rightW = btnW + 16
					-- in a narrow column there is no room for a middle block: fold the
					-- status into the two left lines instead of truncating everything
					local narrow = hasMid and Panel.AbsoluteSize.X < NARROW_W
					if narrow then
						local st1 = tostring(entry.status or "")
						local st2 = tostring(entry.statusSub or "")
						r.Who.Text = tostring(entry.name or "") .. (st1 ~= "" and ('   <font color="#A2A2AE">·</font>  ' .. st1) or "")
						r.Sub.Text = tostring(entry.sub or "") .. (st2 ~= "" and ('  <font color="#74747F">·</font>  ' .. st2) or "")
						r.Who.Size = UDim2.new(1, -rightW - 10, 0, 15)
						r.Sub.Size = UDim2.new(1, -rightW - 10, 0, 15)
					else
						r.Who.Text = tostring(entry.name or "")
						r.Sub.Text = tostring(entry.sub or "")
						local leftW = hasMid and 0.46 or 1
						r.Who.Size = UDim2.new(leftW, hasMid and -10 or -rightW - 10, 0, 15)
						r.Sub.Size = UDim2.new(leftW, hasMid and -10 or -rightW - 10, 0, 15)
					end
					r.Status.Text = tostring(entry.status or "")
					r.StatusSub.Text = tostring(entry.statusSub or "")
					r.Status.Visible = hasMid and not narrow
					r.StatusSub.Visible = hasMid and not narrow
					if isLocked then
						r.btn.Visible = true
						r.badge.Visible = false
						r.btn.Text = "Locked"
						r.btn.BackgroundColor3 = Theme.Track
						r.btn.TextColor3 = Theme.Dim
					elseif entry.button then
						r.btn.Visible = true
						r.badge.Visible = false
						r.btn.Text = tostring(entry.button)
						r.rest = entry.disabled and Theme.Track or badgeColor(entry.buttonColor or "accent")
						r.btn.BackgroundColor3 = r.rest
						r.btn.TextColor3 = entry.disabled and Theme.Dim or ((entry.buttonColor == nil or entry.buttonColor == "accent") and Theme.AccentText or Color3.fromRGB(14, 14, 17))
					elseif entry.badge then
						r.btn.Visible = false
						r.badge.Visible = true
						r.badge.Text = tostring(entry.badge)
						local c = badgeColor(entry.badgeColor or "dim")
						r.badge.TextColor3 = c
						local stroke = r.badge:FindFirstChildOfClass("UIStroke")
						if stroke then stroke.Color = c stroke.Transparency = 0.55 end
					else
						r.btn.Visible = false
						r.badge.Visible = false
					end
				end

				Panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
					Elevate()
					for _, r in pairs(rows) do pcall(ApplyRow, r, r.entry, r.frame.LayoutOrder) end
				end)

				local handle = {}
				-- callers poll from their own threads, and a thread that yielded
				-- through a game remote comes back with a lowered identity, so
				-- re-assert before the first Instance read (the rows live under CoreGui)
				function handle:Alive() Elevate() return Panel.Parent ~= nil end
				function handle:Update(list)
					Elevate()
					if not Panel.Parent then return end
					list = list or {}
					local seen = {}
					local n = 0
					for i, entry in ipairs(list) do
						if i > maxRows then break end
						local id = tostring(entry.id or i)
						seen[id] = true
						n += 1
						local r = rows[id]
						if not r then
							r = BuildRow(entry, i)
							rows[id] = r
						end
						ApplyRow(r, entry, i)
					end
					for id, r in pairs(rows) do
						if not seen[id] then
							pcall(function() r.frame:Destroy() end)
							rows[id] = nil
						end
					end
					Empty.Visible = n == 0
					Count.Text = n > 0 and tostring(n) or ""
					-- grow with the rows up to VisibleRows, never leave a big empty box
					local shownRows = math.clamp(n, 1, visibleRows)
					local h = n == 0 and 22 or (shownRows * (ROW_H + GAP) - GAP)
					Scroll.Size = UDim2.new(1, -PAD * 2, 0, h)
					Panel.Size = UDim2.new(1, 0, 0, PAD + TITLE + (TITLE > 0 and 4 or 0) + lockExtra + h + PAD)
				end
				function handle:Clear() self:Update({}) end

				Register(Panel, lTitle .. " " .. emptyText)
				return handle
			end

			function Elements:AddSupportCard(itemCfg)
				itemCfg = itemCfg or {}
				local sTitle      = tostring(itemCfg.Title or "Support this Project")
				local sDesc       = tostring(itemCfg.Description or itemCfg.Content
					or "Support this project to keep it alive! Your contributions directly fund 24/7 server infrastructure, game bypass updates, and continuous maintenance for the entire community.")
				local qrRaw       = itemCfg.Image or itemCfg.QR
					or "https://cdn.discordapp.com/attachments/1547908995044605992/1549786752225378324/quality_restoration_20260916211820303.png?ex=6aabf6e3&is=6aaaa563&hm=43de30c490e2893c370ba44875023ed6a5974bab0dfc5d936b7daac988132cee"
				local donateUrl   = tostring(itemCfg.Url or itemCfg.Link or "https://sociabuzz.com/senaroblox/tribe")
				local buttonLabel = tostring(itemCfg.ButtonText or "International Sociabuzz")
				local qrSize      = math.max(100, math.min(240, tonumber(itemCfg.QrSize) or 136))

				itemOrder = itemOrder + 1

				local Card = New("Frame", {
					Name = "SupportCard",
					LayoutOrder = itemOrder,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					ClipsDescendants = true,
				}, BodyList)
				Corner(Card, 8)
				Stroke(Card, Theme.Stroke, 1)
				Padding(Card, 10, 10, 10, 10)

				local Layout = New("UIListLayout", {
					Padding = UDim.new(0, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
				}, Card)

				local Title = New("TextLabel", {
					Name = "Title",
					LayoutOrder = 1,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Font = Theme.FontBold,
					Text = sTitle,
					TextColor3 = Theme.Text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextWrapped = true,
				}, Card)

				local Desc = New("TextLabel", {
					Name = "Desc",
					LayoutOrder = 2,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Font = Theme.FontBody,
					Text = sDesc,
					TextColor3 = Theme.SubText,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextWrapped = true,
				}, Card)

				local QrFrame = New("Frame", {
					Name = "QrWrapper",
					LayoutOrder = 3,
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					Size = UDim2.new(0, qrSize, 0, qrSize),
				}, Card)
				Corner(QrFrame, 8)
				Padding(QrFrame, 6, 6, 6, 6)

				local QrImg = New("ImageLabel", {
					Name = "QrCode",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 1, 0),
					ScaleType = Enum.ScaleType.Fit,
					Image = "",
				}, QrFrame)

				task.spawn(function()
					Elevate()
					local assetUri = LoadCustomAsset(qrRaw)
					if assetUri and assetUri ~= "" then
						QrImg.Image = assetUri
					end
				end)

				local CopyBtn = New("TextButton", {
					Name = "CopyLink",
					LayoutOrder = 4,
					Active = true,
					Size = UDim2.new(1, 0, 0, 34),
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
					Font = Theme.FontBold,
					Text = buttonLabel,
					TextColor3 = Theme.AccentText,
					TextSize = 12,
					AutoButtonColor = false,
				}, Card)
				Corner(CopyBtn, 6)

				CopyBtn.MouseEnter:Connect(function()
					Elevate()
					Tween(CopyBtn, QUICK, { BackgroundTransparency = 0.12 })
				end)
				CopyBtn.MouseLeave:Connect(function()
					Elevate()
					Tween(CopyBtn, QUICK, { BackgroundTransparency = 0 })
				end)

				local function DoCopy()
					Elevate()
					local copied = false
					if setclipboard then
						pcall(setclipboard, donateUrl)
						copied = true
					elseif syn and syn.write_clipboard then
						pcall(syn.write_clipboard, donateUrl)
						copied = true
					elseif toclipboard then
						pcall(toclipboard, donateUrl)
						copied = true
					end

					Sena:Notify({
						Title = "Link Copied!",
						Content = "Sociabuzz donation link copied to clipboard.",
						Icon = "check",
						Duration = 4,
					})

					CopyBtn.Text = "Copied to Clipboard! ✓"
					task.delay(2.5, function()
						if CopyBtn and CopyBtn.Parent then
							CopyBtn.Text = buttonLabel
						end
					end)
				end

				OnTap(CopyBtn, DoCopy)
				CopyBtn.MouseButton1Click:Connect(DoCopy)
				CopyBtn.Activated:Connect(DoCopy)

				Register(Card, sTitle .. " " .. sDesc)

				local handle = {}
				function handle:SetTitle(t) Title.Text = tostring(t or "") end
				function handle:SetDescription(d) Desc.Text = tostring(d or "") end
				return handle
			end
			Elements.AddDonationCard = Elements.AddSupportCard

			Elements.AddChat = Elements.AddLiveChat

			Section.Api = Elements
			return Elements
		end

		TabApi.CreateSection = TabApi.AddSection
		TabApi.Title = tabTitle
		TabApi.Key = key

		function TabApi:Select() SelectTab(key) end

		if not Window.CurrentTab then
			SelectTab(key)
		end

		return TabApi
	end

	Window.AddTab = Window.CreateTab

	Sena.Windows[#Sena.Windows + 1] = Window
	SetOpen(true)

	return Window
end


-- Auto-connect ke backend. getgenv().SenaBackend (diset loader) bisa override
-- Api / Key / Game; kalau ga ada, ConnectBackend pakai DEFAULT_BACKEND.
-- Set getgenv().SenaBackend = { Disabled = true } buat matiin.
task.defer(function()
	Elevate()
	local ok, cfg = pcall(function() return getgenv and getgenv().SenaBackend end)
	Sena:ConnectBackend((ok and type(cfg) == "table") and cfg or {})
end)

if getgenv then getgenv().Sena = Sena end

return Sena
