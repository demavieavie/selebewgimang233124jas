local function CountLines(text, width, font, textSize, maxLines)
	text = tostring(text or "")
	if text == "" then return 0 end

	maxLines = maxLines or 3
	width = math.floor(tonumber(width) or 0)

	local lines
	if width >= 20 then
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(text, textSize, font, Vector2.new(width, 100000))
		end)
		if ok and bounds and bounds.Y > 0 then
			lines = math.ceil(bounds.Y / (textSize + 2))
		end
	end

	if not lines then
		local perLine = math.max(10, math.floor((width > 0 and width or 200) / (textSize * 0.52)))
		lines = 0
		for segment in (text .. "\n"):gmatch("(.-)\n") do
			lines = lines + math.max(1, math.ceil(#segment / perLine))
		end
	end

	return math.clamp(lines, 1, maxLines)
end

local function MakeDraggable(handle, target, track)
	local dragging, dragStart, startPos = false, nil, nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	local moved = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart
		target.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end)

	if track then track(moved) end
end

