local NotifyGui, NotifyHolder

local function EnsureNotifyGui()
	if NotifyGui and NotifyGui.Parent then return end

	local parent = GuiParent()

	pcall(function()
		for _, child in ipairs(parent:GetChildren()) do
			if child.Name == "SenaNotify" then
				pcall(function() child:Destroy() end)
			end
		end
	end)

	NotifyGui = New("ScreenGui", {
		AutoLocalize = false,  -- Roblox otomatis nerjemahin 'Join' -> 'Bergabung' dll. dan ngerusak lebar tombol
		Name = "SenaNotify",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ResetOnSpawn = false,
		DisplayOrder = 9999,
	})
	Protect(NotifyGui)
	NotifyGui.Parent = parent

	NotifyHolder = New("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.new(0, 270, 1, -36),
		BackgroundTransparency = 1,
	}, NotifyGui)

	New("UIListLayout", {
		Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, NotifyHolder)
end

function Sena:Notify(config)
	Elevate()
	config = config or {}
	local title    = tostring(config.Title or config[1] or "Sena")
	local content  = tostring(config.Content or config.Description or config[2] or "")
	local duration = tonumber(config.Duration or config.Time or config[3]) or 4
	local icon     = config.Icon

	EnsureNotifyGui()

	local descLines = content ~= "" and CountLines(content, icon and 200 or 226, Theme.FontBody, 12, 4) or 0
	local height = 40 + (descLines > 0 and (descLines * DESC_LINE + 4) or 0)

	local slot = New("Frame", {
		Name = "Slot",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		ClipsDescendants = false,
	}, NotifyHolder)

	local card = New("Frame", {
		Name = "Notification",
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(1, 20, 0, 0),
		BackgroundTransparency = 1,
	}, slot)
	Corner(card, 8)
	local cardStroke = Stroke(card, Theme.Stroke, 1, 1)

	local iconImage, iconBadge
	if icon then
		iconBadge = New("Frame", {
			Name = "Badge",
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 12, 0, 10),
			Size = UDim2.new(0, 28, 0, 28),
			BackgroundTransparency = 1,
		}, card)
		Corner(iconBadge, 8)
		iconImage = New("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 15, 0, 15),
			ImageColor3 = Theme.Text,
			ImageTransparency = 1,
		}, iconBadge)
		ApplyIcon(iconImage, icon, 48)
	end

	local textLeft = icon and 50 or 14

	local titleLabel = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, textLeft, 0, descLines > 0 and 10 or 12),
		Size = UDim2.new(1, -textLeft - 12, 0, 16),
		Font = Theme.FontBold,
		Text = title,
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 1,
	}, card)

	local descLabel
	if content ~= "" then
		descLabel = New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, textLeft, 0, 27),
			Size = UDim2.new(1, -textLeft - 12, 0, descLines * DESC_LINE),
			Font = Theme.FontBody,
			Text = content,
			TextColor3 = Theme.SubText,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextTransparency = 1,
		}, card)
	end

	local bar = New("Frame", {
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 0.35,
	}, card)
	Corner(bar, 2)

	local POP = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	Tween(card, POP, { Position = UDim2.new(0, 0, 0, 0) })
	Tween(card, SMOOTH, { BackgroundTransparency = 0 })
	Tween(cardStroke, SMOOTH, { Transparency = 0 })
	Tween(titleLabel, SMOOTH, { TextTransparency = 0 })
	if descLabel then Tween(descLabel, SMOOTH, { TextTransparency = 0 }) end
	if iconBadge then Tween(iconBadge, SMOOTH, { BackgroundTransparency = 0 }) end
	if iconImage then Tween(iconImage, SMOOTH, { ImageTransparency = 0 }) end
	Tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

	local closed = false
	local function close()
		Elevate()
		if closed then return end
		closed = true
		Tween(card, QUICK, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 })
		Tween(cardStroke, QUICK, { Transparency = 1 })
		Tween(titleLabel, QUICK, { TextTransparency = 1 })
