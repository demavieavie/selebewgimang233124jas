			function Elements:AddSlider(itemCfg)
				itemCfg = itemCfg or {}
				local sTitle   = tostring(itemCfg.Title or itemCfg[1] or "Slider")
				local sDesc    = tostring(itemCfg.Description or itemCfg.Content or itemCfg[2] or "")
				local min      = tonumber(itemCfg.Min) or 0
				local max      = tonumber(itemCfg.Max) or 100
				local increment= tonumber(itemCfg.Increment or itemCfg.Step) or 1
				local default  = tonumber(itemCfg.Default) or min
				local suffix   = tostring(itemCfg.Suffix or "")
				local callback = itemCfg.Callback or function() end
				local flag     = itemCfg.Flag
				local isLocked = (itemCfg.Locked == true or itemCfg.Donator == true) and not IsDonator()

				local Row, TitleLabel, DescLabel, Recalculate, SetExtra = BuildRow("Slider", sTitle, sDesc, 74, 16)

				local ValueLabel = New("TextLabel", {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, ROW_PAD),
					Size = UDim2.new(0, 58, 0, TITLE_H),
					BackgroundTransparency = 1,
					Font = Theme.Font,
					Text = tostring(default) .. suffix,
					TextColor3 = Theme.SubText,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Right,
					Visible = true,
				}, Row)

				local Bar = New("Frame", {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 10, 1, -10),
					Size = UDim2.new(1, -20, 0, 4),
					BackgroundColor3 = Theme.Track,
					BorderSizePixel = 0,
					Visible = true,
				}, Row)
				Corner(Bar, 2)

				local Fill = New("Frame", {
					Size = UDim2.new(0, 0, 1, 0),
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
				}, Bar)
				Corner(Fill, 2)

				local Knob = New("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.new(0, 10, 0, 10),
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
					ZIndex = 4,
				}, Bar)
				Corner(Knob, 5)

				local value = math.clamp(default, min, max)
				local funcs = { Value = value }

				local function Snap(raw)
					if increment <= 0 then return math.clamp(raw, min, max) end
					local snapped = min + math.floor((raw - min) / increment + 0.5) * increment

					snapped = tonumber(string.format("%.4f", snapped)) or snapped
					return math.clamp(snapped, min, max)
				end

				local function Render(animate)
					if isLocked then return end
					local alpha = (max - min) == 0 and 0 or (value - min) / (max - min)
					local info = animate and QUICK or TweenInfo.new(0)
					Tween(Fill, info, { Size = UDim2.new(alpha, 0, 1, 0) })
					Tween(Knob, info, { Position = UDim2.new(alpha, 0, 0.5, 0) })
					ValueLabel.Text = tostring(value) .. suffix
				end

				local function SetValue(newValue, skipCallback, animate)
					if isLocked then return end
					Elevate()
					value = Snap(tonumber(newValue) or min)
					funcs.Value = value
					Render(animate ~= false)
					if not skipCallback then
						task.spawn(function()
							Elevate()
							local ok, err = pcall(callback, value)
							if not ok then warn("[Sena] Slider callback error:", err) end
						end)
					end
				end

				if isLocked then
					ApplyLockBadge(Row, TitleLabel, DescLabel, sTitle, Bar, SetExtra, Recalculate)
				else
					local Hit = New("TextButton", {
						Name = "Hit",
						AnchorPoint = Vector2.new(0, 1),
						Position = UDim2.new(0, 6, 1, -4),
						Size = UDim2.new(1, -12, 0, 16),
						BackgroundTransparency = 1,
						Text = "",
						AutoButtonColor = false,
						ZIndex = 5,
					}, Row)

					local dragging = false

					local function UpdateFromX(x)
						local trackPos = Bar.AbsolutePosition.X
						local trackSize = math.max(1, Bar.AbsoluteSize.X)
						local alpha = math.clamp((x - trackPos) / trackSize, 0, 1)
						SetValue(min + alpha * (max - min), false, false)
					end

					Hit.InputBegan:Connect(function(input)
						Elevate()
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							UpdateFromX(input.Position.X)
							Tween(Knob, QUICK, { Size = UDim2.new(0, 13, 0, 13) })
						end
					end)

					Track(UserInputService.InputChanged:Connect(function(input)
						Elevate()
						if not dragging then return end
						if input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch then
							UpdateFromX(input.Position.X)
						end
					end))

					Track(UserInputService.InputEnded:Connect(function(input)
						Elevate()
						if not dragging then return end
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							dragging = false
							Tween(Knob, QUICK, { Size = UDim2.new(0, 10, 0, 10) })
						end
					end))

					task.defer(function() Render(false) end)
				end

				Register(Row, sTitle .. " " .. sDesc)

				function funcs:Set(newValue, skipCallback) SetValue(newValue, skipCallback) end
				function funcs:Get() return value end
				function funcs:IsLocked() return isLocked end
				Bind(flag, funcs)
				SaveState(sTitle, itemCfg, funcs)

				return funcs
			end

