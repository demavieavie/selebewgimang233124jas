					elseif newValue ~= nil and newValue ~= "" then
						mapped[tostring(newValue)] = true
					end
					selected = mapped
					RefreshRowVisuals()
					UpdateLabel()
					if not skipCallback then FireCallback() else
						local list = SelectedList()
						funcs.Value = multi and list or (list[1] or "")
					end
